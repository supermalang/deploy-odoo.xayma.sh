---
# Ansible Vault secrets for deploy-odoo (k3s) - SHARED MULTI-TENANT POOL MODEL.
# 1. cp defaults/main/02-credentials.yml.example defaults/main/02-credentials.yml
# 2. Replace every CHANGE_ME with a real secret
# 3. ansible-vault encrypt defaults/main/02-credentials.yml --vault-password-file vault_password

# Per-tenant secret derivation seed (see vars/main.yml: `_odoo_admin_password`).
# The tenant's Odoo admin/master password is
# hash('sha256', seed ~ '|' ~ customer_slug ~ '|' ~ instance_slug) - never
# generated/persisted per-tenant. Changing this rotates EVERY tenant's admin
# password on its next odoo_action=deploy run.
vault_odoo_admin_password: "CHANGE_ME_odoo_admin_password_seed"

# Per-pool secret derivation seed (see vars/main.yml: `_pool_db_password`).
# Each pool's single PG LOGIN role password is
# hash('sha256', seed ~ '|' ~ pool_id) - one password per (version, plan)
# pool, shared by every tenant on it. Changing this rotates EVERY pool's DB
# role password on its next odoo_action=deploy/change-plan run.
vault_odoo_db_password: "CHANGE_ME_odoo_db_password_seed"

# Fixed-platform-role secret derivation seed (see vars/main.yml:
# `_pg_superuser_password`/`_pgadmin_ro_password`/`_backup_ro_password`/
# `_pgbouncer_auth_password`/`_redis_password`). One seed derives every
# singleton credential this role creates ONCE for the whole tier (the shared
# Postgres superuser, the read-only pgadmin_ro/backup_ro PG roles, PgBouncer's
# auth_query role, and Redis's requirepass) - each as
# hash('sha256', seed ~ '|' ~ '<fixed-role-name>'). Changing this rotates
# every one of those on the next odoo_action=deploy run against any tenant
# (it flows through _ensure-platform.yml, which every deploy re-applies).
vault_odoo_platform_password: "CHANGE_ME_odoo_platform_password_seed"

# Platform MinIO's scoped `xayma.snapshots` user (Get/Put/Delete objects +
# list the `snapshots` bucket ONLY - no admin API, no access to `uploads` or
# `backups`; see odoo.snapshot_bucket). NOT the platform root user
# (`xayma.admin`) - the secret value lives in install-platform.xayma.sh's
# vault today (`vault_minio_snapshots_password`) and must be copied here.
# The access key itself (`xayma.snapshots`) is a fixed identity, not a
# secret - it is a plain default (see 01-deploy-odoo-defaults.yml's
# `odoo.snapshot_access_key`), not vaulted here. Vaulting it behind a
# CHANGE_ME placeholder is exactly what let the platform MinIO ROOT
# credential hide in plain sight undetected - see git history.
vault_odoo_snapshot_secret_key: "CHANGE_ME_snapshot_secret_key"

# OPTIONAL - only needed if odoo_image_build.enabled is true (see
# defaults/main/01-deploy-odoo-defaults.yml + tasks/_ensure-odoo-image.yml).
# `vault_odoo_dockerhub_token` should be a registry ACCESS TOKEN scoped to
# this one repo (Docker Hub: Account Settings > Security > Personal access
# tokens), never your account password - it's independently revocable.
# Leave both unset/CHANGE_ME if odoo_image_build.enabled stays false, or if
# `odoo_image_repo` is a public repo you push to by some other means.
vault_odoo_dockerhub_username: "CHANGE_ME_dockerhub_username"
vault_odoo_dockerhub_token: "CHANGE_ME_dockerhub_access_token"
