---
# Ansible Vault secrets for deploy-odoo (k3s).
# 1. cp defaults/main/02-credentials.yml.example defaults/main/02-credentials.yml
# 2. Replace every CHANGE_ME with a real secret
# 3. ansible-vault encrypt defaults/main/02-credentials.yml --vault-password-file vault_password
#
# NOTE: the pre-existing defaults/main/02-credentials.yml in this repo was
# encrypted under the OLD key names (postgres_password/postgres_user/
# admin_password for the old docker-compose deploy). It could not be
# re-keyed as part of this migration without the vault password — decrypt
# it, replace its contents with the keys below, and re-encrypt it.

# Master seeds for this role's stateless, deterministic per-instance secret
# derivation (see vars/main.yml): the actual DB password and Odoo master
# password are hash('sha256', seed ~ '|' ~ customer_slug ~ '|' ~ instance_slug)
# for each instance, never generated/persisted per-instance. Changing these
# rotates EVERY instance's DB/admin password on the next action=deploy run.
vault_odoo_db_password: "CHANGE_ME_odoo_db_password_seed"
vault_odoo_admin_password: "CHANGE_ME_odoo_admin_password_seed"

# Platform MinIO (snapshots bucket) — same MinIO the platform's own DB
# backups use, under a separate bucket (see odoo.snapshot_bucket).
vault_odoo_minio_access_key: "CHANGE_ME_minio_access_key"
vault_odoo_minio_secret_key: "CHANGE_ME_minio_secret_key"
