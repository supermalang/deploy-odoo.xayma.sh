#jinja2: lstrip_blocks: True
---
# Regenerated by tasks/_sync-pgbouncer-tenants.yml on every tenant deploy/
# change-plan/delete - a FULL REPLACE from live cluster state, never an
# incremental patch (so concurrent tenant operations can never race/corrupt
# each other's entry). Do not edit by hand - `_pgb_tenant_caps` is a
# {tenant_slug: cap} dict built entirely from live IngressRoute annotations.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ pgbouncer_tenants_configmap_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ platform_base_labels | combine({'app.kubernetes.io/name': 'pgbouncer'}) | to_json }}
data:
  tenants.ini: |
    # Regenerated by tasks/_sync-pgbouncer-tenants.yml - do not edit by hand.
{% for slug, cap in _pgb_tenant_caps.items() %}
    {{ slug }} = host={{ pg_target }} port=5432 max_db_connections={{ cap }}
{% endfor %}
