#jinja2: lstrip_blocks: True
---
# ONE odoo.conf shared by all three of this pool's Deployments - what
# differs per Deployment (workers/max_cron_threads/db_host) is layered on
# top via CLI flags + an env-driven ${DB_HOST} substitution, NOT three
# separate files (see pool-deployments.yaml.j2's initContainer). POOL-SCOPED
# - create-only (see _resolve-pool.yml); the annotation records exactly
# which pool_spec this was built from.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ pool_config_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ pool_labels | to_json }}
  annotations:
    {{ pool_spec_hash_annotation_key }}: "{{ pool_spec_hash }}"
data:
  odoo.conf: |
    [options]
    ; db_user/db_password/db_host are ${PLACEHOLDER} tokens substituted from
    ; the pool Secret + a per-Deployment env var into a shared emptyDir by
    ; each Deployment's own initContainer - never baked in here in
    ; plaintext, and db_host varies (PgBouncer for http, direct Postgres for
    ; cron/gevent - LISTEN/NOTIFY, which gevent's long-polling depends on,
    ; is incompatible with transaction pooling).
    db_user = ${DB_USER}
    db_password = ${DB_PASSWORD}
    db_host = ${DB_HOST}
    db_port = 5432
    dbfilter = ^%d$
    list_db = False

    ; Per-worker-process demand-side cap - NOT the per-tenant fairness
    ; lever. That's PgBouncer's tenant_db_max_connections (see README
    ; "Plan resolution"); raising this does not fix per-tenant starvation,
    ; it only lets one worker hold more PG connections at once.
    db_maxconn = {{ pool_spec.db_maxconn }}

    ; logfile deliberately absent, not "= False" - `logfile`'s real type is
    ; `path` (my_default ''), not boolean (verified against Odoo 19's
    ; odoo/tools/config.py: `--logfile` is `type='path', my_default=''`).
    ; A config-file value of the literal string "False" is silently
    ; SKIPPED for any non-boolean-action option (config.py's
    ; _load_file_options, the exact "isn't a boolean option, skip" warning
    ; live logs showed), falling back to my_default anyway - '', meaning
    ; log to stdout, which is what this container actually wants
    ; (`kubectl logs` is the only debugging surface here). Omitting the
    ; key reaches the identical end state with no warning on every run.
    log_level = warn

    ; http_interface/http_port (NOT bare interface/port - Odoo doesn't
    ; recognize those key names, confirmed live: "unknown option 'interface'"/
    ; "unknown option 'port'"). The gevent/LiveChat worker's own port is
    ; deliberately NOT set here - it only exists in multi-processing mode
    ; (workers >= 1), which only {pool}-gevent runs with, so it's passed as
    ; --gevent-port on that one Deployment's CLI args instead (see
    ; pool-deployments.yaml.j2) rather than unconditionally in the odoo.conf
    ; every pool role shares.
    http_interface = 0.0.0.0
    http_port = 8069
    proxy_mode = True

    ; This pool's own custom/community addons (git-cloned from
    ; odoo.addons_repo_url) plus one entry per odoo.oca_repos - each a
    ; different, public, independently-pinned upstream, git-cloned
    ; separately by its own clone-oca-{{ '{name}' }} initContainer (see
    ; pool-deployments.yaml.j2 and 01-deploy-odoo-defaults.yml's
    ; odoo.oca_repos comment). Derived from that SAME list, not repeated
    ; here by hand - adding an OCA dependency there is enough.
    addons_path = /opt/extra-addons{% for repo in odoo.oca_repos %},/opt/oca-{{ repo.name }}{% endfor %}
    ; session_redis (MANDATORY - no filesystem fallback) is configured
    ; ENTIRELY via ODOO_SESSION_REDIS_* environment variables on the odoo
    ; process, not here - see pool-deployments.yaml.j2. Loading it via
    ; server_wide_modules is still config-file business; its own runtime
    ; behavior is not.
    server_wide_modules = web,session_redis

    ; timezone/language are NOT odoo.conf options in Odoo 19 (verified
    ; against odoo/tools/config.py's options_index directly - neither name
    ; appears anywhere in it, confirming the live "unknown option" warnings
    ; were accurate, not a fluke) - removed rather than replaced; there is
    ; no config-file equivalent, timezone/language are per-company/per-user
    ; DB settings now. load_language is a REAL, separate option
    ; (`--load-language`, still recognized) and is kept - it is what
    ; actually loads the fr_FR translations at DB init time.
    load_language = fr_FR

    ; workers/max_cron_threads are the {pool}-http shape here - {pool}-cron/
    ; {pool}-gevent override BOTH via CLI flags (see pool-deployments.yaml.j2).
    workers = {{ pool_spec.workers }}
    max_cron_threads = 0

    ; limit_memory_soft/hard kept BELOW the pod's own memory limit
    ; ({{ pool_spec.pod.mem_limit }}) so Odoo self-recycles a worker before
    ; Kubernetes OOMKills the whole pod.
    limit_memory_soft = {{ pool_spec.limits.mem_soft }}
    limit_memory_hard = {{ pool_spec.limits.mem_hard }}
    limit_time_cpu = {{ pool_spec.limits.time_cpu }}
    limit_time_real = {{ pool_spec.limits.time_real }}
    limit_request = {{ pool_spec.limits.request }}

    ; osv_memory_count_limit's real type is int (--osv-memory-count-limit,
    ; my_default=0, "By default there is no limit" - verified against
    ; odoo/tools/config.py directly), not boolean - "False" was being
    ; silently skipped (same mechanism as logfile above), falling back to
    ; 0 anyway - "no limit" IS 0 here, so this is now explicit rather than
    ; accidental. osv_memory_age_limit was RENAMED to transient_age_limit
    ; (type float, my_default=1.0 - "Time limit ... records created with a
    ; TransientModel ... are kept" - confirmed the exact same 1.0 default
    ; this pool already wanted, just under the current name).
    osv_memory_count_limit = 0
    transient_age_limit = 1.0

    smtp_server = localhost
    email_from = "exemple@{{ platform_domain }}"

    test_enable = False
    ; without_demo's real type is a boolean CHECK (_check_without_demo,
    ; which calls the same _check_bool every other bool option uses) - "all"
    ; is not one of _check_bool's accepted literals ('1'/'yes'/'true'/'on'),
    ; so this warned "invalid boolean value: 'all', assume True" on every
    ; single process start (this file is read by every pool-http/-cron/
    ; -gevent server start, not just job-init.yaml.j2's one-shot `-i`, even
    ; though without_demo is only ever actually USED during an install).
    ; "True" is accepted directly - same effective behavior (no demo data),
    ; zero warnings. See job-init.yaml.j2's --without-demo CLI flag for the
    ; identical fix on the one process where this setting is actually used.
    without_demo = True
