#jinja2: lstrip_blocks: True
---
# Not pool_spec-derived (minAvailable: 1 is fixed) - always safe to reapply
# regardless of create-only pool semantics.
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: {{ pool_pdb_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ pool_labels_http | to_json }}
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: odoo
      xayma.sh/pool-id: {{ pool_id }}
      xayma.sh/pool-role: http
