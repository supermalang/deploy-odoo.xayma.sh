#jinja2: lstrip_blocks: True
---
# One-shot DB init - Job name is a MUTEX (fixed, not timestamped): retrying
# a failed odoo_action=deploy reapplies the SAME Job name, so a still-
# running init can never be duplicated. NEVER re-runs against an already-
# initialized database - see deploy-tenant.yml's idempotency guard.
#
# Phased (NOT a single `-i` call) so the local filestore this pod's
# emptyDir provides is still present when we migrate off it - see README
# "Architecture"/"Known caveats":
#   1. Install base+fs_storage+fs_attachment+fs_attachment_s3 ONLY. Nothing
#      else has run yet, so nothing tenant-specific has had a chance to
#      write an attachment anywhere.
#   2. fs_storage_upsert.py (shared with job-fixup.yaml.j2 - see
#      fs_storage_scripts_configmap_name) makes the S3 fs.storage the
#      default BEFORE any other module installs, so every attachment any
#      later module creates lands in S3/DB from birth, never on this pod's
#      filesystem.
#   3. Install the tenant's real init_modules (fs_storage/fs_attachment/
#      fs_attachment_s3/base are already installed - `-i` no-ops on them).
#   4. force_storage.py sweeps anything phase 1 wrote locally (e.g.
#      fs_attachment's OWN install-time icons, the one documented gotcha -
#      see fs_storage_upsert.py.j2) onto the now-default fs.storage, while
#      this pod's emptyDir still has those files. Skipping this step is
#      exactly the dangling-attachment bug this phasing exists to close.
apiVersion: batch/v1
kind: Job
metadata:
  name: init-{{ instance_slug }}
  namespace: {{ xayma_namespace }}
  labels: {{ tenant_labels | combine({'xayma.sh/job-role': 'init'}) | to_json }}
spec:
  # 1800s (was 900s for one `-i` call) - this Job now runs two full module
  # installs plus two `odoo shell` invocations in sequence; a tenant with a
  # large init_modules list needs the extra headroom.
  activeDeadlineSeconds: 1800
  backoffLimit: 0
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels: {{ tenant_labels | combine({'xayma.sh/job-role': 'init'}) | to_json }}
    spec:
      restartPolicy: Never
      priorityClassName: {{ priorityclass.name }}
      initContainers:
        # ONE initContainer cloning the addons repo + every odoo.oca_repos
        # entry IN PARALLEL (backgrounded subshells + `wait`), not one
        # initContainer per repo - Kubernetes runs initContainers strictly
        # sequentially, never concurrently with each other, so N separate
        # git-clone initContainers means N round trips paid one after
        # another; one initContainer running N git fetches at once pays
        # roughly max(fetch time) instead of sum(fetch time). No shared PVC
        # (see pool-deployments.yaml.j2's clone-addons for the rationale) -
        # this Job needs the same addons content the pool it's initializing
        # into will run with. The `rm -rf` before `git init` in each
        # subshell matters defensively, even though this Job's
        # restartPolicy: Never means kubelet never restarts a container
        # in-place - see pool-deployments.yaml.j2's clone-addons comment for
        # why a stale target dir must never be what any clone reuses.
        #
        # Each clone runs in its own `( ... )` subshell backgrounded with
        # `&`; `set -eu` inside a subshell still aborts THAT subshell on its
        # own first error (subshells inherit shell options from the parent),
        # so one failing clone doesn't corrupt another's checkout - it just
        # exits that subshell non-zero. We deliberately still `wait` on
        # every PID (not exit on the first failure) so a genuinely
        # unrelated failure (e.g. a bad OCA ref) doesn't hide a SEPARATE,
        # real one (e.g. the addons deploy key expired) that was running
        # concurrently - `status` below goes non-zero if ANY subshell
        # failed, which is what actually fails the initContainer/Job.
        - name: clone-all-repos
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/keys/known_hosts -i /keys/id_ed25519";
              ( rm -rf /addons/.git /addons/*;
                git init -q /addons;
                cd /addons;
                git remote add origin {{ odoo.addons_repo_url }};
                git fetch --depth 1 origin {{ odoo.addons_repo_ref }};
                git checkout -q FETCH_HEAD ) & pids="$!";
{% for repo in odoo.oca_repos %}
              ( rm -rf /oca-{{ repo.name }}/.git /oca-{{ repo.name }}/*;
                git init -q /oca-{{ repo.name }};
                cd /oca-{{ repo.name }};
                git remote add origin {{ repo.url }};
                git fetch --depth 1 origin {{ repo.ref }};
                git checkout -q FETCH_HEAD ) & pids="$pids $!";
{% endfor %}
              status=0;
              for pid in $pids; do wait "$pid" || status=1; done;
              exit "$status"
          volumeMounts:
            - {name: addons-deploy-key, mountPath: /keys, readOnly: true}
            - {name: addons, mountPath: /addons}
{% for repo in odoo.oca_repos %}
            - {name: "oca-{{ repo.name }}", mountPath: "/oca-{{ repo.name }}"}
{% endfor %}
          # Sized for {{ 1 + (odoo.oca_repos | length) }} concurrent
          # `git fetch --depth 1` processes (addons + each oca_repos entry),
          # not just one - was 50m/64Mi-250m/256Mi per repo when these were
          # separate containers; combining them means one container's
          # ceiling now covers all of them running at once.
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {cpu: 500m, memory: 512Mi}
        - name: render-config
          image: busybox:{{ versions.busybox }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              sed
              -e "s|\${DB_USER}|$DB_USER|g"
              -e "s|\${DB_PASSWORD}|$DB_PASSWORD|g"
              -e "s|\${DB_HOST}|$DB_HOST|g"
              /config/odoo.conf > /etc/odoo/odoo.conf
          env:
            - {name: DB_HOST, value: "{{ pg_target }}"}
          envFrom:
            - secretRef: {name: "{{ pool_secret_name }}"}
          volumeMounts:
            - {name: config, mountPath: /config, readOnly: true}
            - {name: etc-odoo, mountPath: /etc/odoo}
          # Required by xayma-odoo-quota: a ResourceQuota that constrains
          # requests/limits forces EVERY container in the pod to declare
          # them, initContainers included - without this the pod is
          # rejected at admission and never even appears (not Pending -
          # simply never created), which is why the Job just sits with 0
          # active/succeeded/failed until activeDeadlineSeconds kills it.
          resources:
            requests: {cpu: 10m, memory: 16Mi}
            limits: {cpu: 100m, memory: 64Mi}
      containers:
        - name: init
          # --no-http below means session_redis's own runtime is never
          # invoked (ODOO_SESSION_REDIS is intentionally left unset here -
          # see pool-deployments.yaml.j2 for where it's actually needed).
          # odoo_image_tag - content-derived, same image the pool itself
          # runs - see _ensure-odoo-image.yml's header comment.
          image: "{{ odoo_image_repo }}:{{ odoo_image_tag }}"
          command: ["/bin/bash", "-c"]
          args:
            # --without-demo=True, not =all - "all" isn't one of Odoo 19's
            # accepted boolean literals (see pool-configmap.yaml.j2's
            # without_demo comment for the full verification); it still
            # worked (Odoo assumed True and logged a warning every time),
            # but "True" gets the identical behavior with no warning.
            - |
              set -euo pipefail
              odoo -c /etc/odoo/odoo.conf -d {{ instance_slug }} \
                -i base,fs_storage,fs_attachment,fs_attachment_s3 \
                --without-demo=True --stop-after-init --no-http
              odoo shell -c /etc/odoo/odoo.conf -d {{ instance_slug }} --no-http \
                < /scripts/fs_storage_upsert.py
              odoo -c /etc/odoo/odoo.conf -d {{ instance_slug }} \
                -i "{{ tenant_spec.init_modules }}" \
                --without-demo=True --stop-after-init --no-http
              odoo shell -c /etc/odoo/odoo.conf -d {{ instance_slug }} --no-http \
                < /scripts/force_storage.py
          env:
            - name: FILESTORE_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: "{{ filestore_secret_name }}"
                  key: FILESTORE_SECRET_KEY
          volumeMounts:
            - {name: etc-odoo, mountPath: /etc/odoo}
            - {name: filestore, mountPath: /var/lib/odoo}
            - {name: addons, mountPath: /opt/extra-addons, readOnly: true}
{% for repo in odoo.oca_repos %}
            - {name: "oca-{{ repo.name }}", mountPath: "/opt/oca-{{ repo.name }}", readOnly: true}
{% endfor %}
            - {name: fs-storage-scripts, mountPath: /scripts, readOnly: true}
          # cpu bumped from 500m/1 to 1/2 (2026-08-06) - this container runs
          # 4 full Odoo process boots in sequence (base+storage install,
          # 2 `odoo shell` scripts, the tenant's real init_modules install -
          # see this file's own header comment for why these can't be
          # merged), and asset-bundle compilation in steps 1+3 is CPU-bound.
          # Flat, NOT plan_spec-driven like pool-deployments.yaml.j2 - 3 of
          # the 4 steps (everything except the real init_modules install)
          # do identical work regardless of plan, so tying this to a
          # tenant's plan would only make the plan-INVARIANT majority of
          # this Job slower for lower tiers, not faster for higher ones.
          # Namespace ResourceQuota headroom checked: requests.cpu=16/
          # limits.cpu=32 (defaults/main/01-deploy-odoo-defaults.yml), and
          # only one of these Jobs runs at a time (Job Template concurrency
          # is off - see README "Concurrency") - negligible against either.
          resources:
            requests: {cpu: "1", memory: 1Gi}
            limits: {cpu: "2", memory: 2Gi}
      volumes:
        - {name: config, configMap: {name: "{{ pool_config_name }}"}}
        - {name: etc-odoo, emptyDir: {}}
        - {name: filestore, emptyDir: {}}
        - {name: addons, emptyDir: {}}
{% for repo in odoo.oca_repos %}
        - {name: "oca-{{ repo.name }}", emptyDir: {}}
{% endfor %}
        - {name: fs-storage-scripts, configMap: {name: "{{ fs_storage_scripts_configmap_name }}"}}
        - name: addons-deploy-key
          secret:
            secretName: "{{ addons_deploy_key_secret_name }}"
            defaultMode: 0400
