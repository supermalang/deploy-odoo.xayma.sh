#jinja2: lstrip_blocks: True
---
# Platform MinIO creds for backup/restore/sync-addons Jobs (rclone env-var
# idiom, matching install-platform.xayma.sh's deploy-databases/templates/
# backup-secret.yaml.j2) - ONE for the whole namespace now (was per-customer
# in the slice model).
apiVersion: v1
kind: Secret
metadata:
  name: {{ minio_secret_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ platform_base_labels | to_json }}
type: Opaque
stringData:
  RCLONE_CONFIG_SNAPSHOT_ACCESS_KEY_ID: {{ odoo.snapshot_access_key | to_json }}
  RCLONE_CONFIG_SNAPSHOT_SECRET_ACCESS_KEY: {{ odoo.snapshot_secret_key | to_json }}
