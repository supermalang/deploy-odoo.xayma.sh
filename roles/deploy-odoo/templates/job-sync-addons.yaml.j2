#jinja2: lstrip_blocks: True
---
# git pull onto the shared addons PVC (mounted read-write HERE only - every
# other consumer mounts it read-only). Operator-driven, not tenant-scoped -
# no fixed mutex name, since concurrent sync-addons calls are rare.
apiVersion: batch/v1
kind: Job
metadata:
  name: sync-addons-{{ ansible_date_time.iso8601_basic_short | lower }}
  namespace: {{ xayma_namespace }}
  labels: {{ platform_base_labels | combine({'xayma.sh/job-role': 'sync-addons'}) | to_json }}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 900
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels: {{ platform_base_labels | combine({'xayma.sh/job-role': 'sync-addons'}) | to_json }}
    spec:
      restartPolicy: Never
      priorityClassName: {{ priorityclass.name }}
      containers:
        - name: sync-addons
          image: alpine/git:{{ versions.git }}
          command: ["sh", "-c"]
          args:
            - >-
              set -eu;
              cd /addons;
              if [ -d .git ]; then
                git remote set-url origin "{{ addons_repo_url }}";
                git fetch origin "{{ addons_repo_ref | default(odoo.addons_repo_ref) }}";
                git checkout -f "{{ addons_repo_ref | default(odoo.addons_repo_ref) }}";
                git reset --hard "origin/{{ addons_repo_ref | default(odoo.addons_repo_ref) }}";
              else
                git clone --branch "{{ addons_repo_ref | default(odoo.addons_repo_ref) }}" "{{ addons_repo_url }}" .;
              fi
          volumeMounts:
            - {name: addons, mountPath: /addons}
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {cpu: 500m, memory: 256Mi}
      volumes:
        - name: addons
          persistentVolumeClaim:
            claimName: odoo-addons
