[options]
#-----------------------------------------------------------------------------
# Database
#-----------------------------------------------------------------------------
db_host = {{ pg_name }}
db_port = 5432
# db_user / db_password are NOT templated here (this file ends up in a
# ConfigMap, not a Secret) — the deployment's initContainer substitutes the
# ${DB_USER}/${DB_PASSWORD}/${ADMIN_PASSWD} placeholders below from the
# instance Secret before Odoo ever reads this file. See odoo-deployment.yaml.j2.
db_user = ${DB_USER}
db_password = ${DB_PASSWORD}
db_name = {{ instance_slug }}
dbfilter = {{ instance_slug }}$
list_db = False

# Master password protecting /web/database/manager. Also templated via the
# initContainer merge (never baked into the ConfigMap in plaintext).
admin_passwd = ${ADMIN_PASSWD}

# Max physical connections to Postgres per worker process.
db_maxconn = {{ plan_db_maxconn }}

#-----------------------------------------------------------------------------
# Logging — stdout only (no file logs), so SigNoz's log collection picks
# these up like any other container's stdout.
#-----------------------------------------------------------------------------
logfile = False
log-level = warn

#-----------------------------------------------------------------------------
# Network
#-----------------------------------------------------------------------------
interface =
port = 8069
proxy_mode = True

#-----------------------------------------------------------------------------
# Long-polling port. Only meaningful (and only routed) when workers > 0 —
# with workers = 0 (threaded mode) Odoo serves polling on the main port.
#-----------------------------------------------------------------------------
longpolling_port = 8072

addons_path = /opt/extra-addons/{{ customer_slug }}/{{ instance_slug }}

timezone = Africa/Dakar
load_language = fr_FR
language = fr_FR
server_wide_modules = web

#-----------------------------------------------------------------------------
# Workers / resource tuning — entirely plan_*-supplied (the Xayma app
# resolves these from the customer's plan; this role only templates them).
# workers = 0 disables prefork (threaded) mode; workers > 0 enables
# multiprocessing and wires the long-polling port above.
#-----------------------------------------------------------------------------
workers = {{ plan_workers }}
max_cron_threads = {{ plan_max_cron_threads }}
limit_memory_soft = {{ plan_mem_soft }}
limit_memory_hard = {{ plan_mem_hard }}
limit_time_cpu = 120
limit_time_real = 300
limit_request = 8196

osv_memory_count_limit = False
osv_memory_age_limit = 1.0

#-----------------------------------------------------------------------------
# Email — left at defaults; outbound mail is configured per-instance from
# within Odoo (Settings > Technical > Outgoing Mail Servers), not here.
#-----------------------------------------------------------------------------
smtp_server = localhost
email_from = "exemple@xayma.net"

#-----------------------------------------------------------------------------
# Testing/demo
#-----------------------------------------------------------------------------
test_enable = False
without_demo = all
