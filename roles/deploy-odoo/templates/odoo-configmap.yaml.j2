#jinja2: lstrip_blocks: True
---
# Non-secret Odoo config. db_user/db_password/admin_passwd are left as
# ${DB_USER}/${DB_PASSWORD}/${ADMIN_PASSWD} placeholders in odoo.conf.j2 —
# the odoo-deployment.yaml.j2 initContainer substitutes them from the
# instance Secret at pod start, so no secret ever lands in this ConfigMap.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ instance_name }}
  namespace: {{ customer_slug }}
  labels: {{ odoo_labels_odoo | to_json }}
data:
  odoo.conf: |
{% filter indent(4, first=true) %}
{% include "odoo.conf.j2" %}
{% endfilter %}
