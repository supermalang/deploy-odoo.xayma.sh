#jinja2: lstrip_blocks: True
---
# Busybox httpd backend serving the suspended/stopped/404/50x static pages -
# ONE for the whole namespace now (was one per customer in the slice
# model), since every tenant shares it. The ConfigMap (suspend-backend-html)
# is applied separately by tasks/_ensure-platform.yml via an inline
# `definition:`, since its data comes from files/*.html via the `file`
# lookup (a plain Jinja include can't reach the role's files/ directory).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ suspend_backend_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ platform_base_labels | combine({'app.kubernetes.io/name': 'suspend-backend'}) | to_json }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: suspend-backend
  template:
    metadata:
      labels: {{ platform_base_labels | combine({'app.kubernetes.io/name': 'suspend-backend'}) | to_json }}
    spec:
      containers:
        - name: suspend-backend
          image: busybox:{{ versions.busybox }}
          command: ["httpd", "-f", "-v", "-p", "80", "-h", "/www"]
          ports:
            - name: http
              containerPort: 80
          volumeMounts:
            - name: html
              mountPath: /www
              readOnly: true
          readinessProbe:
            httpGet: {path: /suspended.html, port: 80}
            initialDelaySeconds: 2
            periodSeconds: 10
          livenessProbe:
            httpGet: {path: /suspended.html, port: 80}
            initialDelaySeconds: 5
            periodSeconds: 20
          resources:
            requests: {cpu: 10m, memory: 16Mi}
            limits: {cpu: 50m, memory: 32Mi}
      volumes:
        - name: html
          configMap:
            name: {{ suspend_backend_name }}-html
---
apiVersion: v1
kind: Service
metadata:
  name: {{ suspend_backend_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ platform_base_labels | combine({'app.kubernetes.io/name': 'suspend-backend'}) | to_json }}
spec:
  selector:
    app.kubernetes.io/name: suspend-backend
  ports:
    - name: http
      port: 80
      targetPort: 80
