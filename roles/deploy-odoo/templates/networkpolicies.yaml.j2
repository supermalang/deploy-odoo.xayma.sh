#jinja2: lstrip_blocks: True
---
# Written BY THIS ROLE: install-platform.xayma.sh's deploy-network-policies
# only iterates its own static platform_namespaces list, so it never applies
# to customer namespaces. Shape mirrors that role's default-deny +
# scoped-allow templates, but scoped tighter (per-instance, not per-zone),
# since one customer namespace can hold several instances that must not be
# able to reach each other's databases.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny-ingress
  namespace: {{ customer_slug }}
  labels:
    app.kubernetes.io/part-of: xayma-platform
    app.kubernetes.io/managed-by: ansible
spec:
  podSelector: {}
  policyTypes:
    - Ingress
---
# Edge (Traefik/kube-system) -> this instance's Odoo, on the app port(s).
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ instance_slug }}-allow-edge-to-odoo
  namespace: {{ customer_slug }}
  labels:
    app.kubernetes.io/part-of: xayma-platform
    app.kubernetes.io/managed-by: ansible
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: odoo
      xayma.sh/instance: {{ instance_slug }}
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
      ports:
        - port: 8069
{% if plan.workers | int > 0 %}
        - port: 8072
{% endif %}
---
# observability zone (pgAdmin, in xayma-tools) -> this instance's Postgres.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ instance_slug }}-allow-observability-to-postgres
  namespace: {{ customer_slug }}
  labels:
    app.kubernetes.io/part-of: xayma-platform
    app.kubernetes.io/managed-by: ansible
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: postgres
      xayma.sh/instance: {{ instance_slug }}
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              xayma.sh/network-zone: observability
      ports:
        - port: 5432
---
# Tight, same-instance-only: this instance's Odoo -> this instance's Postgres.
# No namespaceSelector needed (podSelector alone matches within the same
# namespace) — a sibling instance's Odoo pods carry a different
# xayma.sh/instance value and won't match.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ instance_slug }}-allow-odoo-to-postgres
  namespace: {{ customer_slug }}
  labels:
    app.kubernetes.io/part-of: xayma-platform
    app.kubernetes.io/managed-by: ansible
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: postgres
      xayma.sh/instance: {{ instance_slug }}
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: odoo
              xayma.sh/instance: {{ instance_slug }}
      ports:
        - port: 5432
---
# Tight, same-instance-only: this instance's snapshot/restore Jobs -> this
# instance's Postgres (name=snapshot label, set on snapshot-cronjob.yaml.j2 /
# snapshot-job.yaml.j2 / restore-job.yaml.j2 pods).
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ instance_slug }}-allow-snapshot-to-postgres
  namespace: {{ customer_slug }}
  labels:
    app.kubernetes.io/part-of: xayma-platform
    app.kubernetes.io/managed-by: ansible
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: postgres
      xayma.sh/instance: {{ instance_slug }}
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: snapshot
              xayma.sh/instance: {{ instance_slug }}
      ports:
        - port: 5432
---
# Edge (Traefik/kube-system) -> this customer's shared suspend-backend, used
# by every instance's IngressRoute when suspended/stopped and by the
# 404/50x errors middleware on running instances. Namespace-wide (one
# suspend-backend per customer, not per instance) — fixed name so re-applying
# it on every action=deploy is idempotent.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-edge-to-suspend-backend
  namespace: {{ customer_slug }}
  labels:
    app.kubernetes.io/part-of: xayma-platform
    app.kubernetes.io/managed-by: ansible
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: suspend-backend
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
      ports:
        - port: 80
