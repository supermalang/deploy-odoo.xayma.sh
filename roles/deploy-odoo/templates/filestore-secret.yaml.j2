#jinja2: lstrip_blocks: True
---
# Live ir.attachment S3 credentials (fs_attachment_s3, see
# job-fixup.yaml.j2's fs.storage record) - the scoped `xayma.filestore`
# user, Get/Put/Delete + list on the `odoo-filestore` bucket ONLY. A
# DIFFERENT Secret from minio-secret.yaml.j2's on purpose (least-privilege -
# see 02-credentials.yml.example). Carries both shapes its two consumers
# need: FILESTORE_SECRET_KEY (job-fixup.yaml.j2's plain-env `odoo shell`
# step) and the RCLONE_CONFIG_FILESTORE_* pair (job-purge-filestore.yaml.j2,
# via envFrom, matching minio-secret.yaml.j2's rclone idiom).
apiVersion: v1
kind: Secret
metadata:
  name: {{ filestore_secret_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ platform_base_labels | to_json }}
type: Opaque
stringData:
  FILESTORE_SECRET_KEY: {{ odoo.filestore_secret_key | to_json }}
  RCLONE_CONFIG_FILESTORE_ACCESS_KEY_ID: {{ odoo.filestore_access_key | to_json }}
  RCLONE_CONFIG_FILESTORE_SECRET_ACCESS_KEY: {{ odoo.filestore_secret_key | to_json }}
