#jinja2: lstrip_blocks: True
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance_name }}
  namespace: {{ customer_slug }}
  labels: {{ odoo_labels_odoo | to_json }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: odoo
      xayma.sh/instance: {{ instance_slug }}
  template:
    metadata:
      labels: {{ odoo_labels_odoo | to_json }}
    spec:
      # odoo.conf (ConfigMap) has no secrets in it — db_user/db_password/
      # admin_passwd are ${PLACEHOLDER} tokens substituted from the instance
      # Secret into a shared emptyDir here, so the rendered config the
      # container actually reads never touches a ConfigMap in plaintext.
      initContainers:
        - name: render-config
          image: busybox:{{ versions.busybox }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              sed
              -e "s|\${DB_USER}|$DB_USER|g"
              -e "s|\${DB_PASSWORD}|$DB_PASSWORD|g"
              -e "s|\${ADMIN_PASSWD}|$ADMIN_PASSWD|g"
              /config/odoo.conf > /etc/odoo/odoo.conf
          envFrom:
            - secretRef:
                name: {{ instance_name }}
          volumeMounts:
            - name: config
              mountPath: /config
              readOnly: true
            - name: etc-odoo
              mountPath: /etc/odoo
      containers:
        - name: odoo
          image: odoo:{{ version }}.0
          ports:
            - name: http
              containerPort: 8069
{% if plan_workers | int > 0 %}
            - name: longpolling
              containerPort: 8072
{% endif %}
          envFrom:
            - secretRef:
                name: {{ instance_name }}
          command: ["/bin/bash", "-c"]
          args:
            - |
              set -eu
              export PGPASSWORD="$DB_PASSWORD"
              until psql -h {{ pg_name }} -U "$DB_USER" -d postgres -c 'SELECT 1' >/dev/null 2>&1; do
                echo "waiting for postgres..."; sleep 2;
              done
              if ! psql -h {{ pg_name }} -U "$DB_USER" -d postgres -tAc \
                  "SELECT 1 FROM pg_database WHERE datname='{{ instance_slug }}'" | grep -q 1; then
                echo "initializing {{ instance_slug }}..."
                odoo -c /etc/odoo/odoo.conf -d {{ instance_slug }} -i {{ plan_init_modules }} --without-demo=all --stop-after-init
                echo "env.ref('base.user_admin').write({'password': __import__('os').environ['ADMIN_PASSWD']}); env.cr.commit()" \
                  | odoo shell -c /etc/odoo/odoo.conf -d {{ instance_slug }}
              fi
              exec odoo -c /etc/odoo/odoo.conf
          volumeMounts:
            - name: etc-odoo
              mountPath: /etc/odoo
            - name: filestore
              mountPath: /var/lib/odoo
            - name: addons
              mountPath: /opt/extra-addons
          resources:
            requests:
              cpu: "{{ plan_odoo_cpu_request }}"
              memory: "{{ plan_odoo_mem_request }}"
            limits:
              cpu: "{{ plan_odoo_cpu_limit }}"
              memory: "{{ plan_odoo_mem_limit }}"
          startupProbe:
            httpGet:
              path: /web/login
              port: 8069
            periodSeconds: 10
            failureThreshold: 60      # ~10 min budget for first init + first serve
          readinessProbe:
            httpGet:
              path: /web/login
              port: 8069
            initialDelaySeconds: 30
            periodSeconds: 15
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /web/login
              port: 8069
            initialDelaySeconds: 60
            periodSeconds: 30
            failureThreshold: 6
      volumes:
        - name: config
          configMap:
            name: {{ instance_name }}
        - name: etc-odoo
          emptyDir: {}
        - name: filestore
          persistentVolumeClaim:
            claimName: {{ instance_name }}-filestore
        - name: addons
          persistentVolumeClaim:
            claimName: {{ instance_name }}-addons
