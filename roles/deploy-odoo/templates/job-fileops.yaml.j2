#jinja2: lstrip_blocks: True
---
# Generic one-off operation Job - currently only _assert-init-modules.yml's
# module-existence check (delete-tenant.yml used to also use this for a
# filestore rm-rf, before filestore moved to S3 - see job-purge-filestore.yaml.j2
# for its replacement). Required vars: `_fileops_name` (Job name),
# `_fileops_command` (a shell -c string). Optional: `_fileops_image`
# (default busybox) - _assert-init-modules.yml overrides this to the real
# odoo image so its check can see Odoo's own bundled addons paths too, not
# just the freshly cloned repos this Job otherwise only needs;
# `_fileops_clone_addons` (default false) - set true to get `/addons` and
# one `/oca-{{ '{name}' }}` directory per odoo.oca_repos entry populated by
# the same clone-addons/clone-oca-* initContainers pool-deployments.yaml.j2
# uses (the `rm -rf` before `git init` in each - see that template's
# clone-addons comment for why - applies here too, defensively, even
# though this Job's restartPolicy: Never means kubelet never restarts a
# container in-place). `_fileops_configmap_name` (unset by default) - set
# to a ConfigMap name to mount it read-only at /pool-config, one file per
# data key - _assert-init-modules.yml uses this to read the POOL's actual
# rendered odoo.conf (not re-derive what it SHOULD contain from role vars
# again - see that task's own header comment for why that distinction is
# the whole point).
apiVersion: batch/v1
kind: Job
metadata:
  name: "{{ _fileops_name }}"
  namespace: {{ xayma_namespace }}
  labels: {{ tenant_labels | combine({'xayma.sh/job-role': 'fileops'}) | to_json }}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 300
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels: {{ tenant_labels | combine({'xayma.sh/job-role': 'fileops'}) | to_json }}
    spec:
      restartPolicy: Never
      priorityClassName: {{ priorityclass.name }}
{% if _fileops_clone_addons | default(false) %}
      initContainers:
        - name: clone-addons
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/keys/known_hosts -i /keys/id_ed25519";
              rm -rf /addons/.git /addons/*;
              git init -q /addons;
              cd /addons;
              git remote add origin {{ odoo.addons_repo_url }};
              git fetch --depth 1 origin {{ odoo.addons_repo_ref }};
              git checkout -q FETCH_HEAD
          volumeMounts:
            - {name: addons-deploy-key, mountPath: /keys, readOnly: true}
            - {name: addons, mountPath: /addons}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
{% for repo in odoo.oca_repos %}
        - name: clone-oca-{{ repo.name }}
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              rm -rf /oca-{{ repo.name }}/.git /oca-{{ repo.name }}/*;
              git init -q /oca-{{ repo.name }};
              cd /oca-{{ repo.name }};
              git remote add origin {{ repo.url }};
              git fetch --depth 1 origin {{ repo.ref }};
              git checkout -q FETCH_HEAD
          volumeMounts:
            - {name: "oca-{{ repo.name }}", mountPath: "/oca-{{ repo.name }}"}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
{% endfor %}
{% endif %}
      containers:
        - name: fileops
          image: "{{ _fileops_image | default('busybox:' ~ versions.busybox) }}"
          command: ["sh", "-c", {{ _fileops_command | to_json }}]
{% if _fileops_clone_addons | default(false) or _fileops_configmap_name is defined %}
          volumeMounts:
{% if _fileops_clone_addons | default(false) %}
            - {name: addons, mountPath: /addons}
{% for repo in odoo.oca_repos %}
            - {name: "oca-{{ repo.name }}", mountPath: "/oca-{{ repo.name }}"}
{% endfor %}
{% endif %}
{% if _fileops_configmap_name is defined %}
            - {name: pool-config, mountPath: /pool-config, readOnly: true}
{% endif %}
{% endif %}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 200m, memory: 128Mi}
{% if _fileops_clone_addons | default(false) or _fileops_configmap_name is defined %}
      volumes:
{% if _fileops_clone_addons | default(false) %}
        - {name: addons, emptyDir: {}}
{% for repo in odoo.oca_repos %}
        - {name: "oca-{{ repo.name }}", emptyDir: {}}
{% endfor %}
        - name: addons-deploy-key
          secret:
            secretName: "{{ addons_deploy_key_secret_name }}"
            defaultMode: 0400
{% endif %}
{% if _fileops_configmap_name is defined %}
        - {name: pool-config, configMap: {name: "{{ _fileops_configmap_name }}"}}
{% endif %}
{% endif %}
