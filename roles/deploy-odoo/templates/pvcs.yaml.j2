#jinja2: lstrip_blocks: True
---
# Namespace-wide singletons (was per-instance in the slice model) - every
# tenant lives under filestore/{{ '{slug}' }}/ on this ONE PVC. Mounted RW
# by every pool pod + Job.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: odoo-filestore
  namespace: {{ xayma_namespace }}
  labels: {{ platform_base_labels | to_json }}
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: {{ odoo.storage_class }}
  resources:
    requests:
      storage: {{ odoo.filestore_storage }}
---
# Community/custom addons (incl. session_redis) - populated out-of-band via
# odoo_action=sync-addons, mounted READ-ONLY by every pool pod + init/fixup
# Job (job-init.yaml.j2/job-fixup.yaml.j2 mount it ro; job-sync-addons.yaml.j2
# is the one exception that mounts it read-write).
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: odoo-addons
  namespace: {{ xayma_namespace }}
  labels: {{ platform_base_labels | to_json }}
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: {{ odoo.storage_class }}
  resources:
    requests:
      storage: {{ odoo.addons_storage }}
