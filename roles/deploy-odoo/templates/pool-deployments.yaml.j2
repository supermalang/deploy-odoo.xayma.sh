#jinja2: lstrip_blocks: True
---
# {pool}-http: prefork mode, the ONLY autoscaled Deployment (see
# pool-hpa.yaml.j2). db_host=PgBouncer.
#
# session_redis config (ALL three Deployments) is entirely
# ODOO_SESSION_REDIS_* environment variables, not odoo.conf - verified
# against camptocamp/odoo-cloud-platform's http.py (19.0 branch).
# ODOO_SESSION_REDIS_SSL=0 is REQUIRED (the module defaults to SSL=1; our
# Redis doesn't terminate TLS at all). ODOO_SESSION_REDIS_PREFIX is set to
# this POOL's id, not the tenant - the module has no per-tenant/per-db key
# segment at all, only a `db` field inside the stored session VALUE (see
# README "Known caveats" on why session purge filters on that field).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ pool_http_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ pool_labels_http | to_json }}
  annotations:
    {{ pool_spec_hash_annotation_key }}: "{{ pool_spec_hash }}"
spec:
  replicas: {{ pool_spec.replicas_min }}
  selector:
    matchLabels:
      app.kubernetes.io/name: odoo
      xayma.sh/pool-id: {{ pool_id }}
      xayma.sh/pool-role: http
  template:
    metadata:
      labels: {{ pool_labels_http | to_json }}
      # Rolls this Deployment whenever the pool's odoo.conf ConfigMap
      # content actually changes - see _resolve-pool.yml's
      # pool_config_checksum comment for why this is necessary at all:
      # the ConfigMap is mounted only into the render-config
      # initContainer, which sed's it into a separate emptyDir file ONCE
      # at pod start and never runs again - a running pod has no other
      # way to ever notice the file changed. This does NOT reopen the
      # frozen-pool-spec question (pool_spec/pool_spec_hash - sizing -
      # stays create-only, unaffected): it only makes sure that whenever
      # the ConfigMap DOES get reapplied (every deploy whose
      # pool_spec_hash still matches - see _resolve-pool.yml), the pods
      # actually pick up what's now in it, instead of silently drifting
      # from the file every future render-config initContainer would
      # produce. A Deployment's pod-template annotation changing is what
      # actually triggers the rollout - the object's own top-level
      # annotations would not.
      annotations:
        xayma.sh/config-checksum: "{{ pool_config_checksum }}"
    spec:
      # podAntiAffinity stays PREFERRED (soft) - replicas spreading across
      # nodes labelled odoo.tenants_node_label is a nice-to-have, never worth
      # blocking a pod over. nodeAffinity below is REQUIRED (hard) - see
      # README "Capacity planning": this pool only ever runs on nodes
      # carrying that label, regardless of how many such nodes exist or how
      # big they are. No label anywhere in the cluster = every pod here
      # stays Pending (see _resolve-pool.yml's readyReplicas wait, which
      # then times out and fails the run).
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchLabels:
                    app.kubernetes.io/name: odoo
                    xayma.sh/pool-id: {{ pool_id }}
                    xayma.sh/pool-role: http
{% if odoo.tenants_node_label %}
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - {key: "{{ odoo.tenants_node_label.key }}", operator: In, values: ["{{ odoo.tenants_node_label.value }}"]}
{% endif %}
      initContainers:
        # No shared PVC - every pod clones its own copy of odoo.addons_repo_url
        # at odoo.addons_repo_ref fresh on start (see README "Architecture"
        # and 01-deploy-odoo-defaults.yml's comment on addons_repo_ref for
        # why a branch name here is bootstrap-only, not the production end
        # state). `git fetch --depth 1 origin <ref>` (not `git clone`)
        # because `git clone --branch` can't take a literal SHA, which
        # addons_repo_ref and every odoo.oca_repos[].ref both need to
        # support - this form works identically for either (verified
        # against the real OCA/storage repo at its pinned SHA on
        # 2026-08-04) and avoids pulling either repo's full history on
        # every pod start/HPA scale-up. Auth is the addons-deploy-key
        # Secret (a read-only GitHub deploy key) - see
        # addons-deploy-key-secret.yaml.j2. This makes pod start depend on
        # GitHub being reachable and the deploy key still being valid -
        # see README "Architecture" for the custom-image escape hatch if
        # that ever becomes a problem.
        #
        # `rm -rf /addons/.git /addons/*` FIRST, every attempt, unconditionally
        # - an emptyDir volume survives a CONTAINER restart (it is only
        # cleared when the whole POD is deleted from the node), so without
        # this, a killed attempt's half-fetched tree is exactly what a
        # RESTARTED attempt inherits: `git init`/`git remote add origin`
        # then fail with "remote origin already exists" under `set -eu`
        # before `git fetch` ever runs again - masking the real error (a
        # bad ref, a revoked key, a GitHub outage) behind a misleading one
        # that only ever appears in the FIRST attempt's log, gone the
        # moment kubelet restarts the container (live incident: AWX job
        # 118, three pods stuck Init:CrashLoopBackOff on `clone-addons`,
        # `kubectl logs` showing only "remote origin already exists" on
        # every later attempt - the real cause, `fatal: couldn't find
        # remote ref main`, only surfaced by running the clone by hand in
        # a one-off pod nothing was restarting underneath). Clearing first
        # guarantees a restarted attempt starts from the same clean slate
        # as the first one, so its log always shows the real failure, and
        # a partially-fetched tree left by a killed attempt is never what
        # a pod ends up actually serving.
        - name: clone-addons
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/keys/known_hosts -i /keys/id_ed25519";
              rm -rf /addons/.git /addons/*;
              git init -q /addons;
              cd /addons;
              git remote add origin {{ odoo.addons_repo_url }};
              git fetch --depth 1 origin {{ odoo.addons_repo_ref }};
              git checkout -q FETCH_HEAD
          volumeMounts:
            - {name: addons-deploy-key, mountPath: /keys, readOnly: true}
            - {name: addons, mountPath: /addons}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
        # Separate, independent clones from each PUBLIC repo in
        # odoo.oca_repos (no deploy key needed) - fs_storage/fs_attachment/
        # fs_attachment_s3/server_environment are mandatory platform infra
        # (see tasks/_resolve-plan-spec.yml), not part of the tenant's own
        # custom addons repo above. One initContainer per list entry -
        # adding the next OCA dependency there needs no new block here.
{% for repo in odoo.oca_repos %}
        - name: clone-oca-{{ repo.name }}
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              rm -rf /oca-{{ repo.name }}/.git /oca-{{ repo.name }}/*;
              git init -q /oca-{{ repo.name }};
              cd /oca-{{ repo.name }};
              git remote add origin {{ repo.url }};
              git fetch --depth 1 origin {{ repo.ref }};
              git checkout -q FETCH_HEAD
          volumeMounts:
            - {name: "oca-{{ repo.name }}", mountPath: "/oca-{{ repo.name }}"}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
{% endfor %}
        - name: render-config
          image: busybox:{{ versions.busybox }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              sed
              -e "s|\${DB_USER}|$DB_USER|g"
              -e "s|\${DB_PASSWORD}|$DB_PASSWORD|g"
              -e "s|\${DB_HOST}|$DB_HOST|g"
              /config/odoo.conf > /etc/odoo/odoo.conf
          env:
            - {name: DB_HOST, value: "{{ pgbouncer_name }}"}
          envFrom:
            - secretRef: {name: "{{ pool_secret_name }}"}
          volumeMounts:
            - {name: config, mountPath: /config, readOnly: true}
            - {name: etc-odoo, mountPath: /etc/odoo}
          # Required by xayma-odoo-quota: a ResourceQuota that constrains
          # requests/limits forces EVERY container in the pod to declare
          # them, initContainers included - without this the ReplicaSet
          # can't create a pod at all (ReplicaFailure on the Deployment).
          # Nominal: this only runs a `sed` over one config file, so these
          # exist to satisfy the quota, not to bound real work.
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 100m
              memory: 64Mi
      containers:
        - name: odoo
          image: "{{ odoo_image_repo }}:{{ version }}.0"
          command: ["odoo"]
          args: ["-c", "/etc/odoo/odoo.conf", "--workers={{ pool_spec.workers }}", "--max-cron-threads=0"]
          env:
            - {name: ODOO_SESSION_REDIS, value: "1"}
            - {name: ODOO_SESSION_REDIS_HOST, value: "{{ redis_name }}"}
            - {name: ODOO_SESSION_REDIS_PORT, value: "6379"}
            - {name: ODOO_SESSION_REDIS_SSL, value: "0"}
            - {name: ODOO_SESSION_REDIS_PREFIX, value: "{{ pool_id }}"}
            - name: ODOO_SESSION_REDIS_PASSWORD
              valueFrom:
                secretKeyRef: {name: "{{ redis_secret_name }}", key: REDIS_PASSWORD}
            # fs_storage.eval_options_from_env (see fs_storage_upsert.py.j2)
            # resolves this at the moment any attachment is actually
            # touched - needed on every pod that can serve a request, not
            # just the init/fixup Jobs that create the fs.storage record.
            - name: FILESTORE_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: "{{ filestore_secret_name }}"
                  key: FILESTORE_SECRET_KEY
          ports:
            - {name: http, containerPort: 8069}
          volumeMounts:
            - {name: etc-odoo, mountPath: /etc/odoo}
            - {name: filestore, mountPath: /var/lib/odoo}
            - {name: addons, mountPath: /opt/extra-addons, readOnly: true}
{% for repo in odoo.oca_repos %}
            - {name: "oca-{{ repo.name }}", mountPath: "/opt/oca-{{ repo.name }}", readOnly: true}
{% endfor %}
          resources:
            requests: {cpu: "{{ pool_spec.pod.cpu_request }}", memory: "{{ pool_spec.pod.mem_request }}"}
            limits: {cpu: "{{ pool_spec.pod.cpu_limit }}", memory: "{{ pool_spec.pod.mem_limit }}"}
          startupProbe:
            httpGet: {path: /web/health, port: 8069}
            periodSeconds: 10
            failureThreshold: 60
          readinessProbe:
            httpGet: {path: /web/health, port: 8069}
            initialDelaySeconds: 10
            periodSeconds: 15
            failureThreshold: 6
          livenessProbe:
            httpGet: {path: /web/health, port: 8069}
            initialDelaySeconds: 30
            periodSeconds: 30
            failureThreshold: 6
      volumes:
        - {name: config, configMap: {name: "{{ pool_config_name }}"}}
        - {name: etc-odoo, emptyDir: {}}
        # No PVC - live attachments go straight to the odoo-filestore MinIO
        # bucket via fs_attachment_s3 (see job-fixup.yaml.j2). This is
        # scratch space only now (Odoo's data_dir, misc temp use) - nothing
        # written here needs to survive the pod.
        - {name: filestore, emptyDir: {}}
        - {name: addons, emptyDir: {}}
{% for repo in odoo.oca_repos %}
        - {name: "oca-{{ repo.name }}", emptyDir: {}}
{% endfor %}
        - name: addons-deploy-key
          secret:
            secretName: "{{ addons_deploy_key_secret_name }}"
            defaultMode: 0400
---
apiVersion: v1
kind: Service
metadata:
  name: {{ pool_http_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ pool_labels_http | to_json }}
spec:
  selector:
    app.kubernetes.io/name: odoo
    xayma.sh/pool-id: {{ pool_id }}
    xayma.sh/pool-role: http
  ports:
    - {name: http, port: 8069, targetPort: 8069}
---
