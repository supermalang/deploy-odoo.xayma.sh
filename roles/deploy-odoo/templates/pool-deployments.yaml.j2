#jinja2: lstrip_blocks: True
---
# {pool}-http: prefork mode, the ONLY autoscaled Deployment (see
# pool-hpa.yaml.j2). db_host=PgBouncer.
#
# session_redis config (ALL three Deployments) is entirely
# ODOO_SESSION_REDIS_* environment variables, not odoo.conf - verified
# against camptocamp/odoo-cloud-platform's http.py (19.0 branch).
# ODOO_SESSION_REDIS_SSL=0 is REQUIRED (the module defaults to SSL=1; our
# Redis doesn't terminate TLS at all). ODOO_SESSION_REDIS_PREFIX is set to
# this POOL's id, not the tenant - the module has no per-tenant/per-db key
# segment at all, only a `db` field inside the stored session VALUE (see
# README "Known caveats" on why session purge filters on that field).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ pool_http_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ pool_labels_http | to_json }}
  annotations:
    {{ pool_spec_hash_annotation_key }}: "{{ pool_spec_hash }}"
spec:
  replicas: {{ pool_spec.replicas_min }}
  selector:
    matchLabels:
      app.kubernetes.io/name: odoo
      xayma.sh/pool-id: {{ pool_id }}
      xayma.sh/pool-role: http
  template:
    metadata:
      labels: {{ pool_labels_http | to_json }}
    spec:
      # podAntiAffinity stays PREFERRED (soft) - replicas spreading across
      # nodes labelled odoo.tenants_node_label is a nice-to-have, never worth
      # blocking a pod over. nodeAffinity below is REQUIRED (hard) - see
      # README "Capacity planning": this pool only ever runs on nodes
      # carrying that label, regardless of how many such nodes exist or how
      # big they are. No label anywhere in the cluster = every pod here
      # stays Pending (see _resolve-pool.yml's readyReplicas wait, which
      # then times out and fails the run).
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchLabels:
                    app.kubernetes.io/name: odoo
                    xayma.sh/pool-id: {{ pool_id }}
                    xayma.sh/pool-role: http
{% if odoo.tenants_node_label %}
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - {key: "{{ odoo.tenants_node_label.key }}", operator: In, values: ["{{ odoo.tenants_node_label.value }}"]}
{% endif %}
      initContainers:
        # No shared PVC - every pod clones its own copy of odoo.addons_repo_url
        # at odoo.addons_repo_ref fresh on start (see README "Before adding
        # node 2"/01-deploy-odoo-defaults.yml's comment on addons_repo_ref
        # for why a branch name here is bootstrap-only, not the production
        # end state). Auth is the addons-deploy-key Secret (a read-only
        # GitHub deploy key) - see addons-deploy-key-secret.yaml.j2.
        - name: clone-addons
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/keys/known_hosts -i /keys/id_ed25519"
              git clone {{ odoo.addons_repo_url }} /addons;
              cd /addons;
              git checkout {{ odoo.addons_repo_ref }}
          volumeMounts:
            - {name: addons-deploy-key, mountPath: /keys, readOnly: true}
            - {name: addons, mountPath: /addons}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
        # Separate, independent clone from OCA's PUBLIC storage repo (no
        # deploy key needed) - fs_storage/fs_attachment/fs_attachment_s3 are
        # mandatory platform infra (see tasks/_resolve-plan-spec.yml), not
        # part of the tenant's own custom addons repo above.
        - name: clone-oca-storage
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              git clone {{ odoo.oca_storage_repo_url }} /oca-addons;
              cd /oca-addons;
              git checkout {{ odoo.oca_storage_repo_ref }}
          volumeMounts:
            - {name: oca-addons, mountPath: /oca-addons}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
        - name: render-config
          image: busybox:{{ versions.busybox }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              sed
              -e "s|\${DB_USER}|$DB_USER|g"
              -e "s|\${DB_PASSWORD}|$DB_PASSWORD|g"
              -e "s|\${DB_HOST}|$DB_HOST|g"
              /config/odoo.conf > /etc/odoo/odoo.conf
          env:
            - {name: DB_HOST, value: "{{ pgbouncer_name }}"}
          envFrom:
            - secretRef: {name: "{{ pool_secret_name }}"}
          volumeMounts:
            - {name: config, mountPath: /config, readOnly: true}
            - {name: etc-odoo, mountPath: /etc/odoo}
          # Required by xayma-odoo-quota: a ResourceQuota that constrains
          # requests/limits forces EVERY container in the pod to declare
          # them, initContainers included - without this the ReplicaSet
          # can't create a pod at all (ReplicaFailure on the Deployment).
          # Nominal: this only runs a `sed` over one config file, so these
          # exist to satisfy the quota, not to bound real work.
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 100m
              memory: 64Mi
      containers:
        - name: odoo
          image: "{{ odoo_image_repo }}:{{ version }}.0"
          command: ["odoo"]
          args: ["-c", "/etc/odoo/odoo.conf", "--workers={{ pool_spec.workers }}", "--max-cron-threads=0"]
          env:
            - {name: ODOO_SESSION_REDIS, value: "1"}
            - {name: ODOO_SESSION_REDIS_HOST, value: "{{ redis_name }}"}
            - {name: ODOO_SESSION_REDIS_PORT, value: "6379"}
            - {name: ODOO_SESSION_REDIS_SSL, value: "0"}
            - {name: ODOO_SESSION_REDIS_PREFIX, value: "{{ pool_id }}"}
            - name: ODOO_SESSION_REDIS_PASSWORD
              valueFrom:
                secretKeyRef: {name: "{{ redis_secret_name }}", key: REDIS_PASSWORD}
          ports:
            - {name: http, containerPort: 8069}
          volumeMounts:
            - {name: etc-odoo, mountPath: /etc/odoo}
            - {name: filestore, mountPath: /var/lib/odoo}
            - {name: addons, mountPath: /opt/extra-addons, readOnly: true}
            - {name: oca-addons, mountPath: /opt/oca-addons, readOnly: true}
          resources:
            requests: {cpu: "{{ pool_spec.pod.cpu_request }}", memory: "{{ pool_spec.pod.mem_request }}"}
            limits: {cpu: "{{ pool_spec.pod.cpu_limit }}", memory: "{{ pool_spec.pod.mem_limit }}"}
          startupProbe:
            httpGet: {path: /web/health, port: 8069}
            periodSeconds: 10
            failureThreshold: 60
          readinessProbe:
            httpGet: {path: /web/health, port: 8069}
            initialDelaySeconds: 10
            periodSeconds: 15
            failureThreshold: 6
          livenessProbe:
            httpGet: {path: /web/health, port: 8069}
            initialDelaySeconds: 30
            periodSeconds: 30
            failureThreshold: 6
      volumes:
        - {name: config, configMap: {name: "{{ pool_config_name }}"}}
        - {name: etc-odoo, emptyDir: {}}
        # No PVC - live attachments go straight to the odoo-filestore MinIO
        # bucket via fs_attachment_s3 (see job-fixup.yaml.j2). This is
        # scratch space only now (Odoo's data_dir, misc temp use) - nothing
        # written here needs to survive the pod.
        - {name: filestore, emptyDir: {}}
        - {name: addons, emptyDir: {}}
        - {name: oca-addons, emptyDir: {}}
        - name: addons-deploy-key
          secret:
            secretName: "{{ addons_deploy_key_secret_name }}"
            defaultMode: 0400
---
apiVersion: v1
kind: Service
metadata:
  name: {{ pool_http_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ pool_labels_http | to_json }}
spec:
  selector:
    app.kubernetes.io/name: odoo
    xayma.sh/pool-id: {{ pool_id }}
    xayma.sh/pool-role: http
  ports:
    - {name: http, port: 8069, targetPort: 8069}
---
# {pool}-cron: exactly 1 replica, NEVER scaled, workers=0 (threaded), its
# own max_cron_threads, db_host=Postgres DIRECT. No Service - nothing
# routes traffic here; it still runs a normal single Odoo process
# internally (workers=0), just unreachable except via cron duty.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ pool_cron_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ pool_labels_cron | to_json }}
  annotations:
    {{ pool_spec_hash_annotation_key }}: "{{ pool_spec_hash }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: odoo
      xayma.sh/pool-id: {{ pool_id }}
      xayma.sh/pool-role: cron
  template:
    metadata:
      labels: {{ pool_labels_cron | to_json }}
    spec:
{% if odoo.tenants_node_label %}
      # REQUIRED (hard) - see {pool}-http's identical nodeAffinity above.
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - {key: "{{ odoo.tenants_node_label.key }}", operator: In, values: ["{{ odoo.tenants_node_label.value }}"]}
{% endif %}
      initContainers:
        # No shared PVC - see {pool}-http's identical clone-addons above for
        # the rationale (this pool role needs the same addons content).
        - name: clone-addons
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/keys/known_hosts -i /keys/id_ed25519"
              git clone {{ odoo.addons_repo_url }} /addons;
              cd /addons;
              git checkout {{ odoo.addons_repo_ref }}
          volumeMounts:
            - {name: addons-deploy-key, mountPath: /keys, readOnly: true}
            - {name: addons, mountPath: /addons}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
        # Separate, independent clone from OCA's PUBLIC storage repo (no
        # deploy key needed) - fs_storage/fs_attachment/fs_attachment_s3 are
        # mandatory platform infra (see tasks/_resolve-plan-spec.yml), not
        # part of the tenant's own custom addons repo above.
        - name: clone-oca-storage
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              git clone {{ odoo.oca_storage_repo_url }} /oca-addons;
              cd /oca-addons;
              git checkout {{ odoo.oca_storage_repo_ref }}
          volumeMounts:
            - {name: oca-addons, mountPath: /oca-addons}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
        - name: render-config
          image: busybox:{{ versions.busybox }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              sed
              -e "s|\${DB_USER}|$DB_USER|g"
              -e "s|\${DB_PASSWORD}|$DB_PASSWORD|g"
              -e "s|\${DB_HOST}|$DB_HOST|g"
              /config/odoo.conf > /etc/odoo/odoo.conf
          env:
            - {name: DB_HOST, value: "{{ pg_target }}"}
          envFrom:
            - secretRef: {name: "{{ pool_secret_name }}"}
          volumeMounts:
            - {name: config, mountPath: /config, readOnly: true}
            - {name: etc-odoo, mountPath: /etc/odoo}
          # Required by xayma-odoo-quota: a ResourceQuota that constrains
          # requests/limits forces EVERY container in the pod to declare
          # them, initContainers included - without this the ReplicaSet
          # can't create a pod at all (ReplicaFailure on the Deployment).
          # Nominal: this only runs a `sed` over one config file, so these
          # exist to satisfy the quota, not to bound real work.
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 100m
              memory: 64Mi
      containers:
        - name: odoo
          image: "{{ odoo_image_repo }}:{{ version }}.0"
          command: ["odoo"]
          args: ["-c", "/etc/odoo/odoo.conf", "--workers=0", "--max-cron-threads={{ pool_spec.cron.threads }}"]
          env:
            - {name: ODOO_SESSION_REDIS, value: "1"}
            - {name: ODOO_SESSION_REDIS_HOST, value: "{{ redis_name }}"}
            - {name: ODOO_SESSION_REDIS_PORT, value: "6379"}
            - {name: ODOO_SESSION_REDIS_SSL, value: "0"}
            - {name: ODOO_SESSION_REDIS_PREFIX, value: "{{ pool_id }}"}
            - name: ODOO_SESSION_REDIS_PASSWORD
              valueFrom:
                secretKeyRef: {name: "{{ redis_secret_name }}", key: REDIS_PASSWORD}
          ports:
            - {name: http, containerPort: 8069}
          volumeMounts:
            - {name: etc-odoo, mountPath: /etc/odoo}
            - {name: filestore, mountPath: /var/lib/odoo}
            - {name: addons, mountPath: /opt/extra-addons, readOnly: true}
            - {name: oca-addons, mountPath: /opt/oca-addons, readOnly: true}
          resources:
            requests: {cpu: "{{ pool_spec.pod.cpu_request }}", memory: "{{ pool_spec.pod.mem_request }}"}
            limits: {cpu: "{{ pool_spec.pod.cpu_limit }}", memory: "{{ pool_spec.pod.mem_limit }}"}
          startupProbe:
            httpGet: {path: /web/health, port: 8069}
            periodSeconds: 10
            failureThreshold: 60
          livenessProbe:
            httpGet: {path: /web/health, port: 8069}
            initialDelaySeconds: 30
            periodSeconds: 30
            failureThreshold: 6
      volumes:
        - {name: config, configMap: {name: "{{ pool_config_name }}"}}
        - {name: etc-odoo, emptyDir: {}}
        # No PVC - live attachments go straight to the odoo-filestore MinIO
        # bucket via fs_attachment_s3 (see job-fixup.yaml.j2). This is
        # scratch space only now (Odoo's data_dir, misc temp use) - nothing
        # written here needs to survive the pod.
        - {name: filestore, emptyDir: {}}
        - {name: addons, emptyDir: {}}
        - {name: oca-addons, emptyDir: {}}
        - name: addons-deploy-key
          secret:
            secretName: "{{ addons_deploy_key_secret_name }}"
            defaultMode: 0400
---
# {pool}-gevent: 1 replica, db_host=Postgres DIRECT, Service :8072.
# The gevent/LiveChat worker is NOT selectable via any env var or a
# gevent-only mode - it only exists as a SIDE EFFECT of multi-processing
# mode (workers >= 1), spawned alongside (not instead of) the normal HTTP
# workers, listening on --gevent-port. This pod's regular HTTP worker (the
# one --workers=1 also creates) is simply never sent traffic - Traefik
# only routes /websocket/* here (see tenant-ingressroute.yaml.j2), matching
# Odoo's own documented deployment model ("Builtin server"/"LiveChat").
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ pool_gevent_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ pool_labels_gevent | to_json }}
  annotations:
    {{ pool_spec_hash_annotation_key }}: "{{ pool_spec_hash }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: odoo
      xayma.sh/pool-id: {{ pool_id }}
      xayma.sh/pool-role: gevent
  template:
    metadata:
      labels: {{ pool_labels_gevent | to_json }}
    spec:
{% if odoo.tenants_node_label %}
      # REQUIRED (hard) - see {pool}-http's identical nodeAffinity above.
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - {key: "{{ odoo.tenants_node_label.key }}", operator: In, values: ["{{ odoo.tenants_node_label.value }}"]}
{% endif %}
      initContainers:
        # No shared PVC - see {pool}-http's identical clone-addons above for
        # the rationale (this pool role needs the same addons content).
        - name: clone-addons
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/keys/known_hosts -i /keys/id_ed25519"
              git clone {{ odoo.addons_repo_url }} /addons;
              cd /addons;
              git checkout {{ odoo.addons_repo_ref }}
          volumeMounts:
            - {name: addons-deploy-key, mountPath: /keys, readOnly: true}
            - {name: addons, mountPath: /addons}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
        # Separate, independent clone from OCA's PUBLIC storage repo (no
        # deploy key needed) - fs_storage/fs_attachment/fs_attachment_s3 are
        # mandatory platform infra (see tasks/_resolve-plan-spec.yml), not
        # part of the tenant's own custom addons repo above.
        - name: clone-oca-storage
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              git clone {{ odoo.oca_storage_repo_url }} /oca-addons;
              cd /oca-addons;
              git checkout {{ odoo.oca_storage_repo_ref }}
          volumeMounts:
            - {name: oca-addons, mountPath: /oca-addons}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
        - name: render-config
          image: busybox:{{ versions.busybox }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              sed
              -e "s|\${DB_USER}|$DB_USER|g"
              -e "s|\${DB_PASSWORD}|$DB_PASSWORD|g"
              -e "s|\${DB_HOST}|$DB_HOST|g"
              /config/odoo.conf > /etc/odoo/odoo.conf
          env:
            - {name: DB_HOST, value: "{{ pg_target }}"}
          envFrom:
            - secretRef: {name: "{{ pool_secret_name }}"}
          volumeMounts:
            - {name: config, mountPath: /config, readOnly: true}
            - {name: etc-odoo, mountPath: /etc/odoo}
          # Required by xayma-odoo-quota: a ResourceQuota that constrains
          # requests/limits forces EVERY container in the pod to declare
          # them, initContainers included - without this the ReplicaSet
          # can't create a pod at all (ReplicaFailure on the Deployment).
          # Nominal: this only runs a `sed` over one config file, so these
          # exist to satisfy the quota, not to bound real work.
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 100m
              memory: 64Mi
      containers:
        - name: odoo
          image: "{{ odoo_image_repo }}:{{ version }}.0"
          command: ["odoo"]
          # --workers=0 (the odoo.conf default) is single-threaded mode, and
          # Odoo NEVER spawns a separate gevent/LiveChat worker in that mode
          # - only multi-processing mode (workers >= 1) does, on
          # --gevent-port (confirmed against Odoo's own "Builtin server"
          # docs). This is the one pool role that specifically exists to
          # host that worker, so it needs its own non-zero workers count -
          # 1 is enough; the resulting regular HTTP worker this also spawns
          # is simply never sent any traffic (see tenant-ingressroute.yaml.j2
          # for the /websocket-only routing to this Service).
          args: ["-c", "/etc/odoo/odoo.conf", "--workers=1", "--max-cron-threads=0", "--gevent-port=8072"]
          env:
            - {name: ODOO_SESSION_REDIS, value: "1"}
            - {name: ODOO_SESSION_REDIS_HOST, value: "{{ redis_name }}"}
            - {name: ODOO_SESSION_REDIS_PORT, value: "6379"}
            - {name: ODOO_SESSION_REDIS_SSL, value: "0"}
            - {name: ODOO_SESSION_REDIS_PREFIX, value: "{{ pool_id }}"}
            - name: ODOO_SESSION_REDIS_PASSWORD
              valueFrom:
                secretKeyRef: {name: "{{ redis_secret_name }}", key: REDIS_PASSWORD}
          ports:
            - {name: longpolling, containerPort: 8072}
          volumeMounts:
            - {name: etc-odoo, mountPath: /etc/odoo}
            - {name: filestore, mountPath: /var/lib/odoo}
            - {name: addons, mountPath: /opt/extra-addons, readOnly: true}
            - {name: oca-addons, mountPath: /opt/oca-addons, readOnly: true}
          resources:
            requests: {cpu: "{{ pool_spec.pod.cpu_request }}", memory: "{{ pool_spec.pod.mem_request }}"}
            limits: {cpu: "{{ pool_spec.pod.cpu_limit }}", memory: "{{ pool_spec.pod.mem_limit }}"}
          startupProbe:
            tcpSocket: {port: 8072}
            periodSeconds: 10
            failureThreshold: 60
          livenessProbe:
            tcpSocket: {port: 8072}
            initialDelaySeconds: 30
            periodSeconds: 30
            failureThreshold: 6
      volumes:
        - {name: config, configMap: {name: "{{ pool_config_name }}"}}
        - {name: etc-odoo, emptyDir: {}}
        # No PVC - live attachments go straight to the odoo-filestore MinIO
        # bucket via fs_attachment_s3 (see job-fixup.yaml.j2). This is
        # scratch space only now (Odoo's data_dir, misc temp use) - nothing
        # written here needs to survive the pod.
        - {name: filestore, emptyDir: {}}
        - {name: addons, emptyDir: {}}
        - {name: oca-addons, emptyDir: {}}
        - name: addons-deploy-key
          secret:
            secretName: "{{ addons_deploy_key_secret_name }}"
            defaultMode: 0400
---
apiVersion: v1
kind: Service
metadata:
  name: {{ pool_gevent_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ pool_labels_gevent | to_json }}
spec:
  selector:
    app.kubernetes.io/name: odoo
    xayma.sh/pool-id: {{ pool_id }}
    xayma.sh/pool-role: gevent
  ports:
    - {name: longpolling, port: 8072, targetPort: 8072}
