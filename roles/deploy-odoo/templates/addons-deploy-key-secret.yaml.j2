#jinja2: lstrip_blocks: True
---
# Read-only GitHub deploy key + pinned host key for odoo.addons_repo_url,
# mounted by every `clone-addons` initContainer (pool-deployments.yaml.j2,
# job-init.yaml.j2, job-fixup.yaml.j2, job-fileops.yaml.j2's opt-in module
# check). ONE for the whole namespace (the addons repo is shared platform
# infrastructure, not per-tenant) - applied from _ensure-platform.yml.
apiVersion: v1
kind: Secret
metadata:
  name: {{ addons_deploy_key_secret_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ platform_base_labels | to_json }}
type: Opaque
stringData:
  id_ed25519: {{ vault_odoo_addons_deploy_key | to_json }}
  known_hosts: {{ odoo.addons_repo_known_hosts | to_json }}
