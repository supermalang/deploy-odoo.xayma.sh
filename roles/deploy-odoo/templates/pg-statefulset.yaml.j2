#jinja2: lstrip_blocks: True
---
# ONE shared Postgres for the entire tier (pg_topology: shared - see
# vars/main.yml's `pg_target` seam; per_version/per_pool are reserved for
# later). Node-pinned DELIBERATELY (its PVC is local-path) - see README
# "Migrating platform singletons to node 2". `postgres.node_selector`
# defaults to {} (scheduler's free choice); moving it to a real node is a
# guarded, data-moving runbook (snapshot every tenant, recreate fresh here,
# restore every tenant), not just flipping this value - see the README
# section above.
apiVersion: v1
kind: Secret
metadata:
  name: {{ pg_superuser_secret_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ platform_base_labels | combine({'app.kubernetes.io/name': 'postgres'}) | to_json }}
type: Opaque
stringData:
  POSTGRES_PASSWORD: {{ _pg_superuser_password | to_json }}
---
apiVersion: v1
kind: Service
metadata:
  name: pg
  namespace: {{ xayma_namespace }}
  labels: {{ platform_base_labels | combine({'app.kubernetes.io/name': 'postgres'}) | to_json }}
spec:
  # A regular ClusterIP (not headless) DELIBERATELY - Ansible's
  # community.postgresql modules connect to this service's virtual IP
  # directly from the control node (see tasks/_pg-connection.yml), which
  # only works with a real ClusterIP to route to, not a headless service's
  # per-pod DNS (unresolvable outside cluster DNS). replicas stays 1 while
  # pg_topology == shared, so a plain ClusterIP loses nothing here.
  clusterIP: ""
  selector:
    app.kubernetes.io/name: postgres
  ports:
    - name: postgres
      port: 5432
      targetPort: 5432
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: pg
  namespace: {{ xayma_namespace }}
  labels: {{ platform_base_labels | combine({'app.kubernetes.io/name': 'postgres'}) | to_json }}
spec:
  serviceName: pg
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: postgres
  template:
    metadata:
      labels: {{ platform_base_labels | combine({'app.kubernetes.io/name': 'postgres'}) | to_json }}
    spec:
{% if postgres.node_selector %}
      nodeSelector: {{ postgres.node_selector | to_json }}
{% endif %}
      containers:
        - name: postgres
          image: postgres:{{ versions.postgres }}
          # max_connections passed directly as a `-c` override - no separate
          # postgresql.conf ConfigMap needed for one setting.
          args: ["-c", "max_connections={{ postgres.max_connections }}"]
          env:
            - name: POSTGRES_USER
              value: postgres
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ pg_superuser_secret_name }}
                  key: POSTGRES_PASSWORD
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          ports:
            - name: postgres
              containerPort: 5432
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
          resources:
            requests:
              cpu: "{{ postgres.cpu_request }}"
              memory: "{{ postgres.mem_request }}"
            limits:
              cpu: "{{ postgres.cpu_limit }}"
              memory: "{{ postgres.mem_limit }}"
          readinessProbe:
            exec:
              command: ["pg_isready", "-U", "postgres"]
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            exec:
              command: ["pg_isready", "-U", "postgres"]
            initialDelaySeconds: 30
            periodSeconds: 15
  volumeClaimTemplates:
    - metadata:
        name: data
        labels: {{ platform_base_labels | combine({'app.kubernetes.io/name': 'postgres'}) | to_json }}
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: {{ odoo.storage_class }}
        resources:
          requests:
            storage: {{ postgres.storage }}
