#jinja2: lstrip_blocks: True
---
# Single-tenant pg_dump + filestore tar -> MinIO
# snapshots/{customer}/{instance}/{{ '{_backup_kind}' }}/{timestamp}/ - the
# same layout job-restore.yaml.j2 expects. Designed to be driven by an AWX
# schedule (app-driven loop over tenants - see README "AWX"). `_backup_kind`
# (daily|adhoc) is set by the caller (backup-tenant.yml or delete-tenant.yml's
# final safety backup) - see tasks/_run-tenant-backup.yml.
apiVersion: batch/v1
kind: Job
metadata:
  name: backup-{{ instance_slug }}-{{ ansible_date_time.iso8601_basic_short | lower }}
  namespace: {{ xayma_namespace }}
  labels: {{ tenant_labels | combine({'xayma.sh/job-role': 'backup'}) | to_json }}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 3600
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels: {{ tenant_labels | combine({'xayma.sh/job-role': 'backup'}) | to_json }}
    spec:
      restartPolicy: Never
      priorityClassName: {{ priorityclass.name }}
      initContainers:
        - name: pg-dump
          image: postgres:{{ versions.postgres }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              PGPASSWORD="$POSTGRES_PASSWORD" pg_dump -h {{ pg_target }} -U postgres {{ instance_slug }}
              | gzip > /backup/db.sql.gz
          env:
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{ pg_superuser_secret_name }}"
                  key: POSTGRES_PASSWORD
          volumeMounts:
            - {name: backup, mountPath: /backup}
        - name: filestore-tar
          image: busybox:{{ versions.busybox }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              mkdir -p /filestore/{{ instance_slug }};
              tar czf /backup/filestore.tar.gz -C /filestore/{{ instance_slug }} .
          volumeMounts:
            - {name: filestore, mountPath: /filestore}
            - {name: backup, mountPath: /backup}
      containers:
        - name: rclone-upload
          image: rclone/rclone:{{ versions.rclone }}
          command:
            - /bin/sh
            - -c
            - >-
              set -eu;
              rclone copy /backup/
              snapshot:{{ odoo.snapshot_bucket }}/{{ customer_slug }}/{{ instance_slug }}/{{ _backup_kind }}/{{ ansible_date_time.iso8601_basic_short | lower }}/
          env:
            - {name: RCLONE_CONFIG_SNAPSHOT_TYPE, value: s3}
            - {name: RCLONE_CONFIG_SNAPSHOT_PROVIDER, value: Other}
            - {name: RCLONE_CONFIG_SNAPSHOT_ENDPOINT, value: {{ odoo.snapshot_endpoint | to_json }}}
            - {name: RCLONE_CONFIG_SNAPSHOT_ACL, value: private}
          envFrom:
            - secretRef: {name: "{{ minio_secret_name }}"}
          volumeMounts:
            - {name: backup, mountPath: /backup}
      volumes:
        - {name: backup, emptyDir: {}}
        - name: filestore
          persistentVolumeClaim:
            claimName: odoo-filestore
