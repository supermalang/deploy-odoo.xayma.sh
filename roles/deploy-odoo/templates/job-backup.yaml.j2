#jinja2: lstrip_blocks: True
---
# Single-tenant pg_dump -> MinIO
# snapshots/{customer}/{instance}/{{ '{_backup_kind}' }}/{timestamp}/ - the
# same layout job-restore.yaml.j2 expects. Designed to be driven by an AWX
# schedule (app-driven loop over tenants - see README "AWX"). `_backup_kind`
# (daily|adhoc) is set by the caller (backup-tenant.yml or delete-tenant.yml's
# final safety backup) - see tasks/_run-tenant-backup.yml.
#
# DB-only, deliberately - filestore moved to the platform MinIO's
# odoo-filestore bucket directly (fs_attachment_s3, see job-fixup.yaml.j2),
# a live, already-durable store this Job has no reason to also snapshot.
# Its own durability (versioning/replication) is the platform MinIO's
# concern, not this role's - see README "Known caveats".
apiVersion: batch/v1
kind: Job
metadata:
  name: backup-{{ instance_slug }}-{{ ansible_date_time.iso8601_basic_short | lower }}
  namespace: {{ xayma_namespace }}
  labels: {{ tenant_labels | combine({'xayma.sh/job-role': 'backup'}) | to_json }}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 3600
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels: {{ tenant_labels | combine({'xayma.sh/job-role': 'backup'}) | to_json }}
    spec:
      restartPolicy: Never
      priorityClassName: {{ priorityclass.name }}
      initContainers:
        # bash, NOT sh: this needs `pipefail`, which dash (the image's
        # /bin/sh) does not implement. Without it `pg_dump | gzip > file`
        # reports gzip's exit status, so a failed dump still "succeeds" and
        # writes a ~20-byte empty gzip that rclone then happily uploads -
        # see odoo.backup.min_dump_bytes in 01-deploy-odoo-defaults.yml.
        - name: pg-dump
          image: postgres:{{ versions.postgres }}
          command:
            - /bin/bash
            - -c
            - |-
              set -euo pipefail
              out=/backup/db.sql.gz
              PGPASSWORD="$POSTGRES_PASSWORD" pg_dump -h {{ pg_target }} -U postgres {{ instance_slug }} | gzip > "$out"
              size=$(stat -c %s "$out")
              if [ "$size" -lt {{ odoo.backup.min_dump_bytes }} ]; then
                echo "FATAL: dump is ${size}B, under the {{ odoo.backup.min_dump_bytes }}B floor - treating as failed" >&2
                rm -f "$out"
                exit 1
              fi
              echo "dump OK: $out (${size}B)"
          env:
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{ pg_superuser_secret_name }}"
                  key: POSTGRES_PASSWORD
          volumeMounts:
            - {name: backup, mountPath: /backup}
          resources:
            requests: {cpu: 100m, memory: 256Mi}
            limits: {cpu: 500m, memory: 512Mi}
      containers:
        - name: rclone-upload
          image: rclone/rclone:{{ versions.rclone }}
          command:
            - /bin/sh
            - -c
            - >-
              set -eu;
              rclone copy /backup/
              snapshot:{{ odoo.snapshot_bucket }}/{{ customer_slug }}/{{ instance_slug }}/{{ _backup_kind }}/{{ ansible_date_time.iso8601_basic_short | lower }}/
          env:
            - {name: RCLONE_CONFIG_SNAPSHOT_TYPE, value: s3}
            - {name: RCLONE_CONFIG_SNAPSHOT_PROVIDER, value: Other}
            - {name: RCLONE_CONFIG_SNAPSHOT_ENDPOINT, value: {{ odoo.snapshot_endpoint | to_json }}}
            - {name: RCLONE_CONFIG_SNAPSHOT_ACL, value: private}
          envFrom:
            - secretRef: {name: "{{ minio_secret_name }}"}
          volumeMounts:
            - {name: backup, mountPath: /backup}
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {cpu: 500m, memory: 256Mi}
      volumes:
        - {name: backup, emptyDir: {}}
