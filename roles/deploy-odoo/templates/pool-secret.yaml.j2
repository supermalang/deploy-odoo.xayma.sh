#jinja2: lstrip_blocks: True
---
# ONE PG role per pool (see README "PostgreSQL access model") - shared by
# all three of this pool's Deployments (http via PgBouncer, cron/gevent
# direct to Postgres). Not pool_spec-derived (just credentials), so this is
# always safe to reapply regardless of create-only pool semantics.
apiVersion: v1
kind: Secret
metadata:
  name: {{ pool_secret_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ pool_labels | to_json }}
type: Opaque
stringData:
  DB_USER: {{ pool_pg_role | to_json }}
  DB_PASSWORD: {{ _pool_db_password | to_json }}
