#jinja2: lstrip_blocks: True
---
# ADMIN_PASSWD only (no DB_USER/DB_PASSWORD - those are pool-level now, see
# pool-secret.yaml.j2) - kept so support can still retrieve a tenant's admin
# password the same way as before:
# kubectl get secret {{ tenant_name }} -n {{ xayma_namespace }} -o jsonpath='{.data.ADMIN_PASSWD}' | base64 -d
apiVersion: v1
kind: Secret
metadata:
  name: {{ tenant_name }}
  namespace: {{ xayma_namespace }}
  labels: {{ tenant_labels | to_json }}
type: Opaque
stringData:
  ADMIN_PASSWD: {{ _odoo_admin_password | to_json }}
