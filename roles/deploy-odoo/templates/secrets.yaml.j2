#jinja2: lstrip_blocks: True
---
# DB + admin credentials, kept out of the odoo.conf ConfigMap entirely (see
# the "Apply the odoo.conf ConfigMap" task + odoo-deployment.yaml.j2's
# initContainer merge).
# Values are derived deterministically in vars/main.yml from a per-role vault
# seed + the customer/instance slugs — this role is a stateless executor and
# never persists a generated secret anywhere.
apiVersion: v1
kind: Secret
metadata:
  name: {{ instance_name }}
  namespace: {{ customer_slug }}
  labels: {{ odoo_labels_odoo | to_json }}
type: Opaque
stringData:
  DB_USER: {{ instance_slug | to_json }}
  DB_PASSWORD: {{ _odoo_db_password | to_json }}
  ADMIN_PASSWD: {{ _odoo_admin_password | to_json }}
---
# Platform MinIO creds for the restore Job — one per customer namespace
# (shared by every instance in it, not per-instance), rclone env-var idiom
# matching install-platform.xayma.sh's deploy-databases/templates/backup-secret.yaml.j2.
apiVersion: v1
kind: Secret
metadata:
  name: {{ customer_slug }}-minio
  namespace: {{ customer_slug }}
  labels:
    app.kubernetes.io/part-of: xayma-platform
    app.kubernetes.io/managed-by: ansible
type: Opaque
stringData:
  RCLONE_CONFIG_SNAPSHOT_ACCESS_KEY_ID: {{ odoo.snapshot_access_key | to_json }}
  RCLONE_CONFIG_SNAPSHOT_SECRET_ACCESS_KEY: {{ odoo.snapshot_secret_key | to_json }}
