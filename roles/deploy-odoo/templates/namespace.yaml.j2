#jinja2: lstrip_blocks: True
---
# One namespace per customer, holding every Odoo instance for that customer.
# xayma.sh/network-zone: webservers is NOT for the platform's static
# platform_namespaces loop (deploy-network-policies never sees this
# namespace) — it's so the platform's existing "databases <- webservers"
# NetworkPolicy (a live namespaceSelector, not a static list) recognizes this
# namespace's snapshot Jobs as an allowed source when they reach the platform
# MinIO. This role writes its own default-deny + scoped-allow policies for
# everything else — see networkpolicies.yaml.j2.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ customer_slug }}
  labels:
    xayma.sh/network-zone: webservers
    app.kubernetes.io/part-of: xayma-platform
    app.kubernetes.io/managed-by: ansible
