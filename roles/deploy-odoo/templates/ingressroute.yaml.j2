#jinja2: lstrip_blocks: True
---
# instance_state (running|suspended|stopped) picks the target: Odoo itself
# when running, or the shared suspend-backend (with the matching path-rewrite
# middleware) otherwise. Re-applied by every lifecycle action that changes
# state (start/stop/suspend-instance, deploy-instance, edit-domainname).
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ instance_name }}
  namespace: {{ customer_slug }}
  labels: {{ odoo_labels_odoo | to_json }}
spec:
  entryPoints:
    - websecure
  routes:
{% if instance_state | default('running') == 'running' %}
{% if plan.workers | int > 0 %}
    - match: Host(`{{ domain }}`) && PathPrefix(`/longpolling`)
      kind: Rule
      priority: 100
      services:
        - name: {{ instance_name }}
          port: 8072
      middlewares:
        - name: {{ instance_name }}-errors-404
        - name: {{ instance_name }}-errors-50x
{% endif %}
    - match: Host(`{{ domain }}`)
      kind: Rule
      priority: 50
      services:
        - name: {{ instance_name }}
          port: 8069
      middlewares:
        - name: {{ instance_name }}-errors-404
        - name: {{ instance_name }}-errors-50x
{% else %}
    - match: Host(`{{ domain }}`)
      kind: Rule
      priority: 50
      services:
        - name: {{ suspend_backend_name }}
          port: 80
      middlewares:
        - name: "{{ instance_name }}-{{ instance_state }}"
{% endif %}
  tls:
    secretName: {{ instance_name }}-tls
