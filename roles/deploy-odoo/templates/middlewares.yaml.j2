#jinja2: lstrip_blocks: True
---
# Styled 404/50x on the RUNNING instance (errors middleware, same trick as
# install-platform.xayma.sh's deploy-error-pages, just namespace-local and
# backed by suspend-backend instead of the platform's shared instance).
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: {{ instance_name }}-errors-404
  namespace: {{ customer_slug }}
  labels: {{ odoo_labels_odoo | to_json }}
spec:
  errors:
    status: ["404"]
    service:
      name: {{ suspend_backend_name }}
      port: 80
    query: /404.html
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: {{ instance_name }}-errors-50x
  namespace: {{ customer_slug }}
  labels: {{ odoo_labels_odoo | to_json }}
spec:
  errors:
    status: ["500-599"]
    service:
      name: {{ suspend_backend_name }}
      port: 80
    query: /50x.html
---
# Suspended/stopped state: the IngressRoute points straight at suspend-backend
# and one of these rewrites the request path server-side (no client-visible
# redirect / URL change) so any path serves the right static page with 200.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: {{ instance_name }}-suspended
  namespace: {{ customer_slug }}
  labels: {{ odoo_labels_odoo | to_json }}
spec:
  replacePathRegex:
    regex: ^.*$
    replacement: /suspended.html
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: {{ instance_name }}-stopped
  namespace: {{ customer_slug }}
  labels: {{ odoo_labels_odoo | to_json }}
spec:
  replacePathRegex:
    regex: ^.*$
    replacement: /stopped.html
