#jinja2: lstrip_blocks: True
---
# Idempotent `odoo shell` fixup - runs on EVERY deploy (not just first
# init): resets the admin password to the derived ADMIN_PASSWD, refreshes
# company/country/currency + database.uuid + web.base.url. Country/currency
# default to Senegal/XOF (matches this platform's l10n_sn/Africa-Dakar
# defaults) - override the script below if a tenant needs different ones.
apiVersion: batch/v1
kind: Job
metadata:
  name: fixup-{{ instance_slug }}-{{ ansible_date_time.iso8601_basic_short | lower }}
  namespace: {{ xayma_namespace }}
  labels: {{ tenant_labels | combine({'xayma.sh/job-role': 'fixup'}) | to_json }}
spec:
  activeDeadlineSeconds: 300
  backoffLimit: 0
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels: {{ tenant_labels | combine({'xayma.sh/job-role': 'fixup'}) | to_json }}
    spec:
      restartPolicy: Never
      priorityClassName: {{ priorityclass.name }}
      initContainers:
        # No shared PVC - see pool-deployments.yaml.j2's clone-addons for the
        # rationale; this Job needs the same addons content the pool it's
        # fixing up will run with.
        - name: clone-addons
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/keys/known_hosts -i /keys/id_ed25519"
              git clone {{ odoo.addons_repo_url }} /addons;
              cd /addons;
              git checkout {{ odoo.addons_repo_ref }}
          volumeMounts:
            - {name: addons-deploy-key, mountPath: /keys, readOnly: true}
            - {name: addons, mountPath: /addons}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
        # Separate, independent clone from OCA's PUBLIC storage repo - see
        # pool-deployments.yaml.j2's identical clone-oca-storage.
        - name: clone-oca-storage
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              git clone {{ odoo.oca_storage_repo_url }} /oca-addons;
              cd /oca-addons;
              git checkout {{ odoo.oca_storage_repo_ref }}
          volumeMounts:
            - {name: oca-addons, mountPath: /oca-addons}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
        - name: render-config
          image: busybox:{{ versions.busybox }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              sed
              -e "s|\${DB_USER}|$DB_USER|g"
              -e "s|\${DB_PASSWORD}|$DB_PASSWORD|g"
              -e "s|\${DB_HOST}|$DB_HOST|g"
              /config/odoo.conf > /etc/odoo/odoo.conf
          env:
            - {name: DB_HOST, value: "{{ pg_target }}"}
          envFrom:
            - secretRef: {name: "{{ pool_secret_name }}"}
          volumeMounts:
            - {name: config, mountPath: /config, readOnly: true}
            - {name: etc-odoo, mountPath: /etc/odoo}
          # Required by xayma-odoo-quota - see job-init.yaml.j2's identical
          # render-config for why: without this the pod is rejected at
          # admission and never even appears.
          resources:
            requests: {cpu: 10m, memory: 16Mi}
            limits: {cpu: 100m, memory: 64Mi}
      containers:
        - name: fixup
          # --no-http below means session_redis's own runtime is never
          # invoked (ODOO_SESSION_REDIS is intentionally left unset here -
          # see pool-deployments.yaml.j2 for where it's actually needed).
          image: "{{ odoo_image_repo }}:{{ version }}.0"
          command: ["/bin/bash", "-c"]
          args:
            - |
              set -eu
              cat <<PYEOF | odoo shell -c /etc/odoo/odoo.conf -d {{ instance_slug }} --no-http
              import uuid
              admin = env['res.users'].search([('login', '=', 'admin')], limit=1)
              if admin:
                  admin.password = "$ADMIN_PASSWD"
              country = env['res.country'].search([('code', '=', 'SN')], limit=1)
              currency = env['res.currency'].search([('name', '=', 'XOF')], limit=1)
              company = env.user.company_id
              company.write({
                  'name': "{{ customer }}",
                  'email': "admin@{{ default_domain }}",
                  'country_id': country.id if country else False,
                  'currency_id': currency.id if currency else False,
              })
              env['ir.config_parameter'].set_param('database.uuid', str(uuid.uuid4()))
              env['ir.config_parameter'].set_param('web.base.url', "https://{{ default_domain }}")
              # fs_attachment_s3 (mandatory - see tasks/_resolve-plan-spec.yml):
              # one fs.storage record, upserted by its fixed `code` so this
              # stays idempotent across every deploy. {db_name} is a literal
              # fs_storage placeholder (NOT Jinja) it substitutes itself -
              # this tenant's own database name, so every tenant safely
              # shares the one odoo.filestore_bucket without colliding.
              # ir_attachment.location=db is the OCA-documented workaround
              # for the one gotcha: attachments created earlier in the same
              # transaction fs_attachment itself loads in (e.g. install-time
              # icons) still follow this param, not the fs.storage record -
              # 'db' keeps them durable instead of landing on this pod's
              # now-ephemeral filesystem.
              env['ir.config_parameter'].set_param('ir_attachment.location', 'db')
              fs_storage_vals = {
                  'name': 'MinIO filestore',
                  'code': 'filestore',
                  'protocol': 's3',
                  'options': '{"key": "{{ odoo.filestore_access_key }}", "secret": "$FILESTORE_SECRET_KEY", "endpoint_url": "{{ odoo.filestore_endpoint }}"}',
                  'directory_path': '{{ odoo.filestore_bucket }}/{db_name}',
                  'use_as_default_for_attachments': True,
              }
              fs_storage = env['fs.storage'].search([('code', '=', 'filestore')], limit=1)
              if fs_storage:
                  fs_storage.write(fs_storage_vals)
              else:
                  env['fs.storage'].create(fs_storage_vals)
              env.cr.commit()
              PYEOF
          env:
            - name: ADMIN_PASSWD
              valueFrom:
                secretKeyRef:
                  name: "{{ tenant_name }}"
                  key: ADMIN_PASSWD
            - name: FILESTORE_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: "{{ filestore_secret_name }}"
                  key: FILESTORE_SECRET_KEY
          volumeMounts:
            - {name: etc-odoo, mountPath: /etc/odoo}
            - {name: filestore, mountPath: /var/lib/odoo}
            - {name: addons, mountPath: /opt/extra-addons, readOnly: true}
            - {name: oca-addons, mountPath: /opt/oca-addons, readOnly: true}
          resources:
            requests: {cpu: 250m, memory: 512Mi}
            limits: {cpu: "1", memory: 1Gi}
      volumes:
        - {name: config, configMap: {name: "{{ pool_config_name }}"}}
        - {name: etc-odoo, emptyDir: {}}
        - {name: filestore, emptyDir: {}}
        - {name: addons, emptyDir: {}}
        - {name: oca-addons, emptyDir: {}}
        - name: addons-deploy-key
          secret:
            secretName: "{{ addons_deploy_key_secret_name }}"
            defaultMode: 0400
