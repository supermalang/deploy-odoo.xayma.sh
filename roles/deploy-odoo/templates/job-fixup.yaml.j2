#jinja2: lstrip_blocks: True
---
# Idempotent `odoo shell` fixup - runs on EVERY deploy (not just first
# init): resets the admin password to the derived ADMIN_PASSWD, refreshes
# company/country/currency + database.uuid + web.base.url, and re-upserts
# the fs.storage record (see fs_storage_upsert.py.j2 - shared with
# job-init.yaml.j2, mounted here from the fs-storage-scripts ConfigMap).
# Country/currency default to Senegal/XOF (matches this platform's
# l10n_sn/Africa-Dakar defaults) - override the script below if a tenant
# needs different ones.
#
# Deliberately renders fixup_image/fixup_pool_config_name/
# fixup_pool_secret_name, NOT the plain version/pool_config_name/
# pool_secret_name vars/main.yml also derives from version/plan - those
# are AWX survey fields (extra_vars ALWAYS win over set_fact/task vars, no
# exception, per Ansible's own precedence rules), and this Job is called
# from restore-tenant.yml, where version/plan must NOT come from whatever
# the survey happened to send. Callers set these three explicitly:
# deploy-tenant.yml builds fixup_image from its own (legitimately real)
# odoo_image_repo/odoo_image_tag plus pool_*; restore-tenant.yml builds it
# from the fixed-up tenant's OWN pool's actual running image (read live
# off its Deployment, not reconstructed) plus tenant_pool_id, recovered
# from live state. Never widen this template to read the plain names
# again.
#
# fixup_image is a full repo-colon-tag reference, not a bare version this
# template appends ".0" to itself - this Job used to build that string
# here directly from a fixup_version variable, which broke the instant
# _ensure-odoo-image.yml started tagging images by content hash (see that
# file's header comment): deploy-tenant.yml's own fixup call would have
# tried to pull a bare version-dot-zero tag that no longer existed once
# the pool's real image moved to a hashed tag, and restore-tenant.yml's
# call has no way to know what hash suffix a DIFFERENT, historical pool's
# image was last built with anyway. Passing the full ref lets each caller
# supply whatever is actually correct for its own situation instead of
# this template guessing.
apiVersion: batch/v1
kind: Job
metadata:
  name: fixup-{{ instance_slug }}-{{ ansible_date_time.iso8601_basic_short | lower }}
  namespace: {{ xayma_namespace }}
  labels: {{ tenant_labels | combine({'xayma.sh/job-role': 'fixup'}) | to_json }}
spec:
  activeDeadlineSeconds: 300
  backoffLimit: 0
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels: {{ tenant_labels | combine({'xayma.sh/job-role': 'fixup'}) | to_json }}
    spec:
      restartPolicy: Never
      priorityClassName: {{ priorityclass.name }}
      initContainers:
        # No shared PVC - see pool-deployments.yaml.j2's clone-addons for the
        # rationale; this Job needs the same addons content the pool it's
        # fixing up will run with. The `rm -rf` before `git init` below
        # matters here too, defensively, even though this Job's
        # restartPolicy: Never means kubelet never restarts a container
        # in-place - see pool-deployments.yaml.j2's clone-addons comment
        # for why a stale /addons must never be what any clone reuses.
        - name: clone-addons
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/keys/known_hosts -i /keys/id_ed25519";
              rm -rf /addons/.git /addons/*;
              git init -q /addons;
              cd /addons;
              git remote add origin {{ odoo.addons_repo_url }};
              git fetch --depth 1 origin {{ odoo.addons_repo_ref }};
              git checkout -q FETCH_HEAD
          volumeMounts:
            - {name: addons-deploy-key, mountPath: /keys, readOnly: true}
            - {name: addons, mountPath: /addons}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
        # Separate, independent clones from each PUBLIC repo in
        # odoo.oca_repos - see pool-deployments.yaml.j2's identical loop.
{% for repo in odoo.oca_repos %}
        - name: clone-oca-{{ repo.name }}
          image: alpine/git:{{ versions.git }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              rm -rf /oca-{{ repo.name }}/.git /oca-{{ repo.name }}/*;
              git init -q /oca-{{ repo.name }};
              cd /oca-{{ repo.name }};
              git remote add origin {{ repo.url }};
              git fetch --depth 1 origin {{ repo.ref }};
              git checkout -q FETCH_HEAD
          volumeMounts:
            - {name: "oca-{{ repo.name }}", mountPath: "/oca-{{ repo.name }}"}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
{% endfor %}
        - name: render-config
          image: busybox:{{ versions.busybox }}
          command:
            - sh
            - -c
            - >-
              set -eu;
              sed
              -e "s|\${DB_USER}|$DB_USER|g"
              -e "s|\${DB_PASSWORD}|$DB_PASSWORD|g"
              -e "s|\${DB_HOST}|$DB_HOST|g"
              /config/odoo.conf > /etc/odoo/odoo.conf
          env:
            - {name: DB_HOST, value: "{{ pg_target }}"}
          envFrom:
            - secretRef: {name: "{{ fixup_pool_secret_name }}"}
          volumeMounts:
            - {name: config, mountPath: /config, readOnly: true}
            - {name: etc-odoo, mountPath: /etc/odoo}
          # Required by xayma-odoo-quota - see job-init.yaml.j2's identical
          # render-config for why: without this the pod is rejected at
          # admission and never even appears.
          resources:
            requests: {cpu: 10m, memory: 16Mi}
            limits: {cpu: 100m, memory: 64Mi}
      containers:
        - name: fixup
          # --no-http below means session_redis's own runtime is never
          # invoked (ODOO_SESSION_REDIS is intentionally left unset here -
          # see pool-deployments.yaml.j2 for where it's actually needed).
          image: "{{ fixup_image }}"
          command: ["/bin/bash", "-c"]
          args:
            - |
              set -eu
              # Quoted heredoc delimiter ('PYEOF', not PYEOF) - the shell
              # must NOT expand anything inside this Python body. An
              # unquoted heredoc used to let $ADMIN_PASSWD/$FILESTORE_SECRET_KEY
              # get substituted before odoo shell ever saw them, so the
              # RESOLVED plaintext secret got persisted to fs_storage.options
              # (a row readable by any tenant admin - see
              # fs_storage_upsert.py.j2's header comment). ADMIN_PASSWD is
              # read from os.environ instead, in Python, now that the shell
              # can no longer touch it. This also fixes a latent quoting
              # hazard: a secret containing '"' or '\' used to produce
              # invalid JSON/Python once substituted; a literal env var name
              # has neither.
              {
                cat /scripts/fs_storage_upsert.py
                cat <<'PYEOF'
              import os
              import uuid
              admin = env['res.users'].search([('login', '=', 'admin')], limit=1)
              if admin:
                  admin.password = os.environ['ADMIN_PASSWD']
              country = env['res.country'].search([('code', '=', 'SN')], limit=1)
              currency = env['res.currency'].search([('name', '=', 'XOF')], limit=1)
              company = env.user.company_id
              company.write({
                  'name': "{{ customer }}",
                  'email': "admin@{{ default_domain }}",
                  'country_id': country.id if country else False,
                  'currency_id': currency.id if currency else False,
              })
              env['ir.config_parameter'].set_param('database.uuid', str(uuid.uuid4()))
              env['ir.config_parameter'].set_param('web.base.url', "https://{{ default_domain }}")
              env.cr.commit()
              PYEOF
              } | odoo shell -c /etc/odoo/odoo.conf -d {{ instance_slug }} --no-http
          env:
            - name: ADMIN_PASSWD
              valueFrom:
                secretKeyRef:
                  name: "{{ tenant_name }}"
                  key: ADMIN_PASSWD
            - name: FILESTORE_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: "{{ filestore_secret_name }}"
                  key: FILESTORE_SECRET_KEY
          volumeMounts:
            - {name: etc-odoo, mountPath: /etc/odoo}
            - {name: filestore, mountPath: /var/lib/odoo}
            - {name: addons, mountPath: /opt/extra-addons, readOnly: true}
{% for repo in odoo.oca_repos %}
            - {name: "oca-{{ repo.name }}", mountPath: "/opt/oca-{{ repo.name }}", readOnly: true}
{% endfor %}
            - {name: fs-storage-scripts, mountPath: /scripts, readOnly: true}
          resources:
            requests: {cpu: 250m, memory: 512Mi}
            limits: {cpu: "1", memory: 1Gi}
      volumes:
        - {name: config, configMap: {name: "{{ fixup_pool_config_name }}"}}
        - {name: etc-odoo, emptyDir: {}}
        - {name: filestore, emptyDir: {}}
        - {name: addons, emptyDir: {}}
{% for repo in odoo.oca_repos %}
        - {name: "oca-{{ repo.name }}", emptyDir: {}}
{% endfor %}
        - {name: fs-storage-scripts, configMap: {name: "{{ fs_storage_scripts_configmap_name }}"}}
        - name: addons-deploy-key
          secret:
            secretName: "{{ addons_deploy_key_secret_name }}"
            defaultMode: 0400
